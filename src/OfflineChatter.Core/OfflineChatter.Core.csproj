<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>OfflineChatter.Core</RootNamespace>
    <AssemblyName>OfflineChatter.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.38.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Резервный TLS 1.2/1.3 для старых систем (уровень 3). Costura грузит сборку лениво. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- Вшитые корневые сертификаты (уровень 2): Net/Roots/*.cer -->
    <EmbeddedResource Include="Net\Roots\*.cer" LogicalName="Roots.%(Filename).cer" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OfflineChatter.Core.Tests" />
  </ItemGroup>

</Project>
