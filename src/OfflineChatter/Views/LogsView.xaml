<UserControl x:Class="OfflineChatter.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:OfflineChatter.Core.Diagnostics;assembly=OfflineChatter.Core"
             xmlns:l="clr-namespace:OfflineChatter.Localization"
             xmlns:c="clr-namespace:OfflineChatter.Controls">
    <DockPanel Margin="24,20,24,20">
        <TextBlock DockPanel.Dock="Top" Text="{l:Loc Nav_Logs}" Style="{StaticResource PageTitleText}" />
        <!-- Фильтры растягиваются, кнопки уходят на отдельную строку в узком окне -->
        <c:AdaptiveRow DockPanel.Dock="Top" Margin="0,0,0,8" Breakpoint="760">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" MinWidth="100" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" DisplayMemberPath="Title" MinWidth="110" Margin="6,0,0,0" />
                <Grid Grid.Column="2" Margin="6,0,0,0">
                    <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=300}" Padding="30,5,9,5" />
                    <Path Data="{StaticResource IconSearch}" Style="{StaticResource IconPath}" Margin="9,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                          TextElement.Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Text="{l:Loc Logs_Filter}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource EmptyToVisible}}" />
                </Grid>
            </Grid>
            <WrapPanel HorizontalAlignment="Right">
                <CheckBox Content="{l:Loc Logs_Auto}" IsChecked="{Binding AutoRefresh}" VerticalAlignment="Center" Margin="0,0,10,4" />
                <Button Content="{l:Loc Logs_Copy}" Command="{Binding CopyAllCommand}" Margin="0,0,6,4" />
                <Button Content="{l:Loc Logs_Bundle}" Command="{Binding BundleCommand}" Margin="0,0,6,4" />
                <Button Style="{DynamicResource SubtleButtonStyle}" Command="{Binding OpenFolderCommand}" Margin="0,0,0,4" ToolTip="{l:Loc Settings_OpenLogs}">
                    <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                </Button>
            </WrapPanel>
        </c:AdaptiveRow>        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
        <Border Style="{StaticResource Card}" Padding="2">
            <ListBox x:Name="Entries" ItemsSource="{Binding Entries}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontFamily="{DynamicResource MonoFontFamily}" FontSize="12">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="6,2" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type d:LogEntry}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{Binding Time, Mode=OneWay, StringFormat='HH:mm:ss.fff'}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <Run x:Name="Lvl" Text="{Binding Level, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Run Text="{Binding Source, Mode=OneWay}" Foreground="{DynamicResource AccentTextBrush}" />
                                <Run Text="{Binding Message, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Data}" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="24,0,0,0"
                                       Visibility="{Binding Data, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock Text="{Binding Exception}" Foreground="{DynamicResource StatusErrorBrush}" TextWrapping="Wrap" Margin="24,0,0,0"
                                       Visibility="{Binding Exception, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Warn">
                                <Setter TargetName="Lvl" Property="Foreground" Value="{DynamicResource StatusWarnBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                <Setter TargetName="Lvl" Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Fatal">
                                <Setter TargetName="Lvl" Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
