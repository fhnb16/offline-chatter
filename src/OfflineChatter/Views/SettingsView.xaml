<UserControl x:Class="OfflineChatter.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OfflineChatter.Localization"
             xmlns:c="clr-namespace:OfflineChatter.Controls"
             xmlns:vm="clr-namespace:OfflineChatter.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="EnumItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
        </DataTemplate>

        <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}" />

        <!-- Заголовок группы внутри вкладки -->
        <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleText}">
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>

        <Style x:Key="Row" TargetType="c:AdaptiveRow">
            <Setter Property="ControlMinWidth" Value="240" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Заголовок и вкладки: остаются на месте при прокрутке -->
        <StackPanel DockPanel.Dock="Top" Margin="24,20,24,0">
            <TextBlock Text="{l:Loc Nav_Settings}" Style="{StaticResource PageTitleText}" Margin="0,0,0,12" />
            <ListBox Style="{StaticResource TabStrip}" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                     ItemTemplate="{StaticResource EnumItemTemplate}" />
            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,8,24,32">

                <!-- ================= Общие ================= -->
                <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource EqualsToVisibility}, ConverterParameter=General}">
                    <Border Style="{StaticResource SettingCard}" Margin="0,8,0,8">
                        <StackPanel>
                            <c:AdaptiveRow Style="{StaticResource Row}">
                                <TextBlock Text="{l:Loc Settings_Language}" Style="{StaticResource SettingLabel}" />
                                <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Title"
                                          SelectedValuePath="Code" SelectedValue="{Binding Language}" />
                            </c:AdaptiveRow>
                            <DockPanel Margin="0,10,0,0" Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVisibility}}">
                                <Button DockPanel.Dock="Right" Content="{l:Loc Settings_Restart}" Command="{Binding RestartNowCommand}" />
                                <TextBlock Text="{l:Loc Settings_RestartRequired}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <CheckBox IsChecked="{Binding SendWithCtrlEnter}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Settings_SendCtrlEnter}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Loc Settings_SendCtrlEnterHint}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                    <Border Style="{StaticResource SettingCard}">
                        <CheckBox IsChecked="{Binding CloseToTray}">
                            <TextBlock Text="{l:Loc Settings_CloseToTray}" Style="{StaticResource SettingLabel}" />
                        </CheckBox>
                    </Border>
                    <Border Style="{StaticResource SettingCard}">
                        <CheckBox IsChecked="{Binding QuickAskHotkey}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Settings_QuickAskHotkey}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{Binding QuickAskHint}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <TextBlock Text="{l:Loc Settings_Sidebar}" Style="{StaticResource GroupTitle}" />
                    <TextBlock Text="{l:Loc Settings_SidebarHint}" Style="{StaticResource CaptionText}" Margin="0,-4,0,8" />
                    <Border Style="{StaticResource SettingCard}" Padding="8,4">
                        <ItemsControl ItemsSource="{Binding SidebarItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NavToggle}">
                                    <DockPanel Margin="8,4">
                                        <Button DockPanel.Dock="Right" Style="{DynamicResource SubtleButtonStyle}" Content="{l:Loc Settings_Open}"
                                                Command="{Binding OpenCommand}" />
                                        <CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource IconPath}" Data="{Binding IconKey, Converter={StaticResource ResourceKeyToGeometry}}"
                                                      TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Button Content="{l:Loc Update_RunWizard}" Command="{Binding RunWizardCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>

                <!-- ================= Оформление ================= -->
                <StackPanel DataContext="{Binding Appearance}"
                            Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Appearance}">
                    <TextBlock Text="{Binding ResolvedSummary}" Style="{StaticResource CaptionText}" Margin="0,8,0,8" />
                    <Border Style="{StaticResource SettingCard}">
                        <c:AdaptiveRow Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Appearance_Skin}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Loc Appearance_SkinHint}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding SkinOptions}" SelectedItem="{Binding Skin}" ItemTemplate="{StaticResource EnumItemTemplate}" />
                        </c:AdaptiveRow>
                    </Border>
                    <Border Style="{StaticResource SettingCard}">
                        <c:AdaptiveRow Style="{StaticResource Row}">
                            <TextBlock Text="{l:Loc Appearance_Mode}" Style="{StaticResource SettingLabel}" />
                            <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding Mode}" ItemTemplate="{StaticResource EnumItemTemplate}" />
                        </c:AdaptiveRow>
                    </Border>
                    <Border Style="{StaticResource SettingCard}">
                        <c:AdaptiveRow Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Appearance_Backdrop}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Loc Appearance_BackdropHint}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding BackdropOptions}" SelectedItem="{Binding Backdrop}" ItemTemplate="{StaticResource EnumItemTemplate}" />
                        </c:AdaptiveRow>
                    </Border>
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <c:AdaptiveRow Style="{StaticResource Row}">
                                <TextBlock Text="{l:Loc Appearance_Accent}" Style="{StaticResource SettingLabel}" />
                                <ComboBox ItemsSource="{Binding AccentOptions}" SelectedItem="{Binding Accent}" ItemTemplate="{StaticResource EnumItemTemplate}" />
                            </c:AdaptiveRow>
                            <ItemsControl ItemsSource="{Binding Swatches}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SwatchButton}" Background="{Binding}" ToolTip="{Binding}"
                                                Command="{Binding DataContext.PickSwatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <c:AdaptiveRow Margin="0,4,0,0" Visibility="{Binding IsCustomAccent, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Row}">
                                <TextBlock Text="{l:Loc Appearance_Hex}" Style="{StaticResource CaptionText}" />
                                <TextBox Text="{Binding CustomAccent, UpdateSourceTrigger=PropertyChanged}" ToolTip="#RRGGBB" />
                            </c:AdaptiveRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Чат ================= -->
                <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Chat}">
                    <TextBlock Text="{l:Loc Prompts_Title}" Style="{StaticResource GroupTitle}" />
                    <TextBlock Text="{l:Loc Prompts_Hint}" Style="{StaticResource CaptionText}" Margin="0,-4,0,8" />
                    <Border Style="{StaticResource SettingCard}" DataContext="{Binding Prompts}">
                        <StackPanel>
                            <c:AdaptiveRow Style="{StaticResource Row}">
                                <TextBlock Text="{l:Loc Prompts_Preset}" Style="{StaticResource SettingLabel}" />
                                <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" />
                            </c:AdaptiveRow>
                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                                <TextBlock Text="{l:Loc Prompts_Name}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                <TextBlock Text="{l:Loc Prompts_Text}" Style="{StaticResource CaptionText}" Margin="0,10,0,4" />
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Delay=400}" AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="96" MaxHeight="320" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                                <CheckBox IsChecked="{Binding IsDefault}" Margin="0,10,0,0">
                                    <TextBlock Text="{l:Loc Prompts_Default}" Style="{StaticResource SettingLabel}" />
                                </CheckBox>
                            </StackPanel>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Command="{Binding AddCommand}" Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPlus}" Style="{StaticResource IconPath}" />
                                        <TextBlock Text="{l:Loc Prompts_Add}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DeleteCommand}" Content="{l:Loc Common_Remove}" Margin="0,0,8,4" />
                                <Button Style="{DynamicResource SubtleButtonStyle}" Command="{Binding RestoreDefaultsCommand}" Content="{l:Loc Prompts_Restore}" Margin="0,0,8,4" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{l:Loc Settings_ImageSection}" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource SettingCard}">
                        <c:AdaptiveRow Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Settings_ImageMaxSide}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Loc Settings_ImageMaxSideHint}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding ImageSizeOptions}" SelectedItem="{Binding ImageMaxSide}" DisplayMemberPath="Title" />
                        </c:AdaptiveRow>
                    </Border>
                    <Border Style="{StaticResource SettingCard}">
                        <c:AdaptiveRow Style="{StaticResource Row}">
                            <TextBlock Text="{l:Loc Settings_ImageQuality}" Style="{StaticResource SettingLabel}" />
                            <ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding ImageQuality}" />
                        </c:AdaptiveRow>
                    </Border>
                    <Border Style="{StaticResource SettingCard}">
                        <CheckBox IsChecked="{Binding KeepPngWithAlpha}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Settings_ImageKeepPng}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Loc Settings_ImageKeepPngHint}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <TextBlock Text="{l:Loc Nav_Mcp}" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource SettingCard}">
                        <CheckBox IsChecked="{Binding ToolsByDefault}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Settings_ToolsByDefault}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Loc Settings_ToolsByDefaultHint}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </StackPanel>

                <!-- ================= Сеть ================= -->
                <StackPanel DataContext="{Binding Network}"
                            Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Network}">
                    <Border Style="{StaticResource NoticeCard}" Margin="0,8,0,8" Visibility="{Binding OfflineMode, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Path Data="{StaticResource IconOffline}" Style="{StaticResource IconPath}" Margin="0,0,10,0" />
                            <TextBlock Text="{l:Loc Net_OfflineBanner}" Style="{StaticResource BodyText}" />
                        </DockPanel>
                    </Border>

                    <TextBlock Text="{l:Loc Net_RouteTitle}" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource SettingCard}">
                        <c:AdaptiveRow Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Net_Interface}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Loc Net_InterfaceHint}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="6,0,0,0" Height="32" Width="32"
                                        Command="{Binding RefreshAdaptersCommand}" ToolTip="{l:Loc Common_Refresh}">
                                    <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPath}" />
                                </Button>
                                <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedInterface}" DisplayMemberPath="Title" />
                            </DockPanel>
                        </c:AdaptiveRow>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <c:AdaptiveRow Style="{StaticResource Row}">
                                <TextBlock Text="{l:Loc Net_Proxy}" Style="{StaticResource SettingLabel}" />
                                <ComboBox ItemsSource="{Binding ProxyModes}" SelectedItem="{Binding ProxyMode}" ItemTemplate="{StaticResource EnumItemTemplate}" />
                            </c:AdaptiveRow>
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsManualProxy, Converter={StaticResource BoolToVisibility}}">
                                <c:AdaptiveRow Style="{StaticResource Row}">
                                    <TextBlock Text="{l:Loc Net_ProxyType}" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding ProxyKinds}" SelectedItem="{Binding ProxyKind}" ItemTemplate="{StaticResource EnumItemTemplate}" />
                                </c:AdaptiveRow>
                                <c:AdaptiveRow Style="{StaticResource Row}" Margin="0,8,0,0">
                                    <TextBlock Text="{l:Loc Net_ProxyHost}" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding ProxyHost, UpdateSourceTrigger=PropertyChanged, Delay=500}" ToolTip="127.0.0.1" />
                                </c:AdaptiveRow>
                                <c:AdaptiveRow Style="{StaticResource Row}" Margin="0,8,0,0">
                                    <TextBlock Text="{l:Loc Net_ProxyPort}" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged, Delay=500}" ToolTip="1080" />
                                </c:AdaptiveRow>
                                <c:AdaptiveRow Style="{StaticResource Row}" Margin="0,8,0,0">
                                    <TextBlock Text="{l:Loc Net_ProxyUser}" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding ProxyUser, UpdateSourceTrigger=PropertyChanged, Delay=500}" />
                                </c:AdaptiveRow>
                                <c:AdaptiveRow Style="{StaticResource Row}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{l:Loc Net_ProxyPassword}" Style="{StaticResource CaptionText}" />
                                        <TextBlock Text="{l:Loc Net_PasswordSaved}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Visibility="{Binding HasProxyPassword, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <PasswordBox x:Name="ProxyPassword" LostFocus="OnProxyPasswordLostFocus" />
                                </c:AdaptiveRow>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,12" />
                                <TextBlock Text="{l:Loc Net_ProxyLink}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Loc Net_ProxyLinkHint}" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{l:Loc Net_ProxyLinkApply}" Command="{Binding ApplyProxyLinkCommand}" Margin="8,0,0,0" />
                                    <TextBox Text="{Binding ProxyLink, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFontFamily}"
                                             ToolTip="socks5h://user:password@127.0.0.1:1080" />
                                </DockPanel>
                                <TextBlock Text="{Binding ProxyLinkStatus}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                           Visibility="{Binding ProxyLinkStatus, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{l:Loc Net_ManagedStackNote}" Style="{StaticResource CaptionText}" Margin="4,0,0,8"
                               Visibility="{Binding UsesManagedStack, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{l:Loc Net_SecurityTitle}" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource SettingCard}">
                        <c:AdaptiveRow Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Net_Tls}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Loc Net_TlsHint}" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding RootsInfo}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding TlsModes}" SelectedItem="{Binding TlsMode}" ItemTemplate="{StaticResource EnumItemTemplate}" />
                        </c:AdaptiveRow>
                    </Border>
                    <Border Style="{StaticResource SettingCard}">
                        <c:AdaptiveRow Style="{StaticResource Row}">
                            <TextBlock Text="{l:Loc Net_Timeout}" Style="{StaticResource SettingLabel}" />
                            <ComboBox ItemsSource="{Binding TimeoutOptions}" SelectedItem="{Binding TimeoutSeconds}" />
                        </c:AdaptiveRow>
                    </Border>

                    <TextBlock Text="{l:Loc Net_DownloadsTitle}" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource SettingCard}">
                        <c:AdaptiveRow Style="{StaticResource Row}">
                            <TextBlock Text="{l:Loc Net_Concurrent}" Style="{StaticResource SettingLabel}" />
                            <ComboBox ItemsSource="{Binding ConcurrencyOptions}" SelectedItem="{Binding MaxConcurrentDownloads}" />
                        </c:AdaptiveRow>
                    </Border>
                    <Border Style="{StaticResource SettingCard}">
                        <c:AdaptiveRow Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Net_SpeedLimit}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Loc Net_SpeedLimitHint}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                            <TextBox Text="{Binding SpeedLimitKBps}" />
                        </c:AdaptiveRow>
                    </Border>
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Net_Mirrors}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{l:Loc Net_MirrorsHint}" Style="{StaticResource CaptionText}" Margin="0,0,0,8" />
                            <c:AdaptiveRow Style="{StaticResource Row}">
                                <TextBlock Text="{l:Loc Net_HfMirror}" Style="{StaticResource CaptionText}" />
                                <TextBox Text="{Binding HfEndpoint}" />
                            </c:AdaptiveRow>
                            <c:AdaptiveRow Style="{StaticResource Row}" Margin="0,8,0,0">
                                <TextBlock Text="{l:Loc Net_GitHubApi}" Style="{StaticResource CaptionText}" />
                                <TextBox Text="{Binding GitHubApiEndpoint}" />
                            </c:AdaptiveRow>
                            <c:AdaptiveRow Style="{StaticResource Row}" Margin="0,8,0,0">
                                <TextBlock Text="{l:Loc Net_GitHubPrefix}" Style="{StaticResource CaptionText}" />
                                <TextBox Text="{Binding GitHubDownloadPrefix}" />
                            </c:AdaptiveRow>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}" Margin="0,16,0,8">
                        <StackPanel>
                            <c:AdaptiveRow>
                                <TextBlock Text="{l:Loc Net_CheckTitle}" Style="{StaticResource SettingLabel}" />
                                <Button Command="{Binding CheckCommand}" Content="{l:Loc Net_Check}" HorizontalAlignment="Right" />
                            </c:AdaptiveRow>
                            <ProgressBar IsIndeterminate="True" Margin="0,10,0,0"
                                         Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding CheckResults}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource StatusOkBrush}" Margin="0,0,8,0" VerticalAlignment="Top"
                                                     DockPanel.Dock="Left" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Host}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource CaptionText}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Ok}" Value="False">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource StatusErrorBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Локальный API ================= -->
                <StackPanel DataContext="{Binding Api}"
                            Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=LocalApi}">
                    <TextBlock Text="{l:Loc Api_Hint}" Style="{StaticResource CaptionText}" Margin="0,8,0,8" />
                    <Border Style="{StaticResource SettingCard}">
                        <CheckBox IsChecked="{Binding ExposeApi}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Api_Enable}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Loc Api_EnableHint}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <StackPanel IsEnabled="{Binding ExposeApi}">
                        <Border Style="{StaticResource SettingCard}">
                            <c:AdaptiveRow Style="{StaticResource Row}">
                                <TextBlock Text="{l:Loc Api_Port}" Style="{StaticResource SettingLabel}" />
                                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged, Delay=600}" FontFamily="{DynamicResource MonoFontFamily}" />
                            </c:AdaptiveRow>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Api_Key}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Loc Api_KeyHint}" Style="{StaticResource CaptionText}" Margin="0,0,0,8" />
                                <Grid>
                                    <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged, Delay=600}" FontFamily="{DynamicResource MonoFontFamily}"
                                             Visibility="{Binding IsKeyVisible, Converter={StaticResource BoolToVisibility}}" />
                                    <Border Style="{StaticResource Card}" Padding="8,6" MinHeight="32"
                                            Visibility="{Binding IsKeyVisible, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="{Binding DisplayKey}" FontFamily="{DynamicResource MonoFontFamily}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                                <WrapPanel Margin="0,8,0,0">
                                    <ToggleButton IsChecked="{Binding IsKeyVisible}" Margin="0,0,8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconEye}" Style="{StaticResource IconPath}" />
                                            <TextBlock Text="{l:Loc Api_Show}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <Button Command="{Binding CopyKeyCommand}" Margin="0,0,8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconPath}" />
                                            <TextBlock Text="{l:Loc Api_Copy}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding RegenerateKeyCommand}" Margin="0,0,8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconKey}" Style="{StaticResource IconPath}" />
                                            <TextBlock Text="{l:Loc Api_Regenerate}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <CheckBox IsChecked="{Binding AllowLan}">
                                <StackPanel>
                                    <TextBlock Text="{l:Loc Api_Lan}" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{l:Loc Api_LanHint}" Style="{StaticResource CaptionText}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource SettingCard}" Margin="0,8,0,8">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Api_Url}" Style="{StaticResource SettingLabel}" />
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CopyUrlCommand}" ToolTip="{l:Loc Api_Copy}">
                                    <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconPath}" />
                                </Button>
                                <StackPanel>
                                    <TextBox Text="{Binding LocalUrl, Mode=OneWay}" IsReadOnly="True" FontFamily="{DynamicResource MonoFontFamily}" />
                                    <TextBox Text="{Binding LanUrl, Mode=OneWay}" IsReadOnly="True" FontFamily="{DynamicResource MonoFontFamily}" Margin="0,6,0,0"
                                             Visibility="{Binding LanUrl, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{l:Loc Api_Example}" Style="{StaticResource CaptionText}" Margin="0,12,0,4" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CopyExampleCommand}" ToolTip="{l:Loc Api_Copy}"
                                        VerticalAlignment="Top">
                                    <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconPath}" />
                                </Button>
                                <Border Background="{DynamicResource CodeBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                    <TextBlock Text="{Binding Example}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding ServerStatus}" Style="{StaticResource BodyText}" />
                            <TextBlock Text="{Binding ModelHint}" Style="{StaticResource CaptionText}" Margin="0,2,0,10" />
                            <WrapPanel>
                                <Button Command="{Binding ApplyCommand}" Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPlay}" Style="{StaticResource IconPath}" />
                                        <TextBlock Text="{l:Loc Api_Apply}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding StopServerCommand}" Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconStop}" Style="{StaticResource IconPath}" />
                                        <TextBlock Text="{l:Loc Api_Stop}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Message}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                       Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Приватность ================= -->
                <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Privacy}">
                    <Border Style="{StaticResource SettingCard}" Margin="0,8,0,8" DataContext="{Binding Network}">
                        <CheckBox IsChecked="{Binding OfflineMode}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Net_Offline}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Loc Net_OfflineHint}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                    <Border Style="{StaticResource SettingCard}" DataContext="{Binding Network}">
                        <CheckBox IsChecked="{Binding CheckUpdates}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Update_AutoCheck}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Loc Update_AutoCheckHint}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                    <Border Style="{StaticResource SettingCard}">
                        <CheckBox IsChecked="{Binding LogMessageContent}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Settings_LogContent}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Loc Settings_LogContentHint}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <TextBlock Text="{l:Loc Settings_Security}" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding SecurityState}" Style="{StaticResource BodyText}" />
                            <TextBlock Text="{l:Loc Security_Hint}" Style="{StaticResource CaptionText}" Margin="0,2,0,10" />
                            <c:AdaptiveRow Style="{StaticResource Row}">
                                <TextBlock Text="{l:Loc Security_NewPassword}" Style="{StaticResource CaptionText}" />
                                <PasswordBox x:Name="MasterPwd" />
                            </c:AdaptiveRow>
                            <c:AdaptiveRow Style="{StaticResource Row}" Margin="0,8,0,0">
                                <TextBlock Text="{l:Loc Security_Confirm}" Style="{StaticResource CaptionText}" />
                                <PasswordBox x:Name="MasterPwd2" />
                            </c:AdaptiveRow>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="{l:Loc Security_Set}" Click="OnSetMasterPassword" Margin="0,0,8,4" />
                                <Button Content="{l:Loc Security_Disable}" Command="{Binding DisableMasterPasswordCommand}" Margin="0,0,8,4"
                                        Visibility="{Binding IsMasterPassword, Converter={StaticResource BoolToVisibility}}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding SecurityStatus}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                       Visibility="{Binding SecurityStatus, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Данные ================= -->
                <StackPanel DataContext="{Binding Data}"
                            Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Data}">
                    <TextBlock Text="{l:Loc Data_ChatsTitle}" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Data_ChatsHint}" Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                            <WrapPanel>
                                <Button Command="{Binding ExportChatsCommand}" Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconExport}" Style="{StaticResource IconPath}" />
                                        <TextBlock Text="{l:Loc Data_Export}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ImportChatsCommand}" Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconImport}" Style="{StaticResource IconPath}" />
                                        <TextBlock Text="{l:Loc Data_Import}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{l:Loc Data_BackupTitle}" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Data_BackupHint}" Style="{StaticResource CaptionText}" Margin="0,0,0,8" />
                            <CheckBox IsChecked="{Binding IncludeChats}" Margin="0,0,0,10">
                                <TextBlock Text="{l:Loc Data_IncludeChats}" Style="{StaticResource SettingLabel}" />
                            </CheckBox>
                            <WrapPanel>
                                <Button Command="{Binding CreateBackupCommand}" Content="{l:Loc Data_Backup}" Margin="0,0,8,4" />
                                <Button Command="{Binding RestoreBackupCommand}" Content="{l:Loc Data_Restore}" Margin="0,0,8,4" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <ProgressBar IsIndeterminate="True" Margin="0,4,0,4" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" Margin="4,0,0,8"
                               Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />

                    <TextBlock Text="{l:Loc Data_Folders}" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding DataLocation}" Style="{StaticResource CaptionText}" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                                        <TextBlock Text="{l:Loc Settings_OpenData}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconList}" Style="{StaticResource IconPath}" />
                                        <TextBlock Text="{l:Loc Settings_OpenLogs}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= О программе ================= -->
                <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource EqualsToVisibility}, ConverterParameter=About}">
                    <Border Style="{StaticResource SettingCard}" Margin="0,8,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding AppVersion}" Style="{StaticResource SubtitleText}" />
                            <TextBlock Text="{Binding OsName}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding RuntimeInfo}" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{l:Loc Update_Title}" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <c:AdaptiveRow>
                                <TextBlock Text="{Binding UpdateStatus, TargetNullValue={l:Loc Update_NotChecked}}" Style="{StaticResource BodyText}" />
                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="{l:Loc Update_Check}" Command="{Binding CheckUpdatesCommand}" Margin="8,0,0,4" />
                                    <Button Style="{DynamicResource AccentButtonStyle}" Content="{l:Loc Update_Install}" Command="{Binding InstallUpdateCommand}" Margin="8,0,0,4"
                                            Visibility="{Binding Update.CanInstall, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                </WrapPanel>
                            </c:AdaptiveRow>
                            <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding UpdateNotes}" Style="{StaticResource CaptionText}" Margin="0,10,0,0" MaxHeight="200"
                                       Visibility="{Binding UpdateNotes, Converter={StaticResource NullToCollapsed}}" />
                            <Button Style="{DynamicResource SubtleButtonStyle}" Content="{l:Loc Update_Open}" Command="{Binding OpenUpdatePageCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingCard}">
                        <c:AdaptiveRow Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Update_Repo}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Loc Update_RepoHint}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                            <TextBox Text="{Binding UpdateRepo}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip="owner/repo" />
                        </c:AdaptiveRow>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
