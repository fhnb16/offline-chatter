<UserControl x:Class="OfflineChatter.Views.BenchmarksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OfflineChatter.ViewModels"
             xmlns:l="clr-namespace:OfflineChatter.Localization">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="{l:Loc Nav_Benchmarks}" Style="{StaticResource PageTitleText}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- llama-bench -->
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="llama-bench" Style="{StaticResource SubtitleText}" />
                        <TextBlock Text="{l:Loc Bench_LlamaHint}" Style="{StaticResource CaptionText}" />
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <Run Text="{l:Loc Bench_Model}" /><Run Text="{Binding ActiveModelName, Mode=OneWay, StringFormat=' {0}'}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Loc Bench_Prompt}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding PromptTokens}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:Loc Bench_Gen}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding GenTokens}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{l:Loc Bench_Reps}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Repetitions}" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Loc Profiles_Threads}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Threads}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:Loc Bench_Ngl}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding GpuLayers}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Flash Attention" IsChecked="{Binding FlashAttention}" Margin="0,10,0,0" />
                        <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding RunLlamaBenchCommand}" HorizontalAlignment="Left" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlay}" Style="{StaticResource IconPath}" />
                                <TextBlock Text="{l:Loc Bench_Run}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- chat-bench -->
                <Border Grid.Column="2" Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="chat-bench" Style="{StaticResource SubtitleText}" />
                        <TextBlock Text="{l:Loc Bench_ChatHint}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{l:Loc Bench_Target}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding ChatTarget}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ModelOption}">
                                    <TextBlock>
                                        <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="{Binding Group, Mode=OneWay, StringFormat='  {0}'}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Loc Bench_Runs}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ChatRuns}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:Loc Profiles_MaxTokens}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ChatMaxTokens}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{l:Loc Bench_Prompts}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ChatPrompts}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                        <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding RunChatBenchCommand}" HorizontalAlignment="Left" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlay}" Style="{StaticResource IconPath}" />
                                <TextBlock Text="{l:Loc Bench_Run}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Ход выполнения -->
            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Content="{l:Loc Common_Cancel}" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            </DockPanel>
            <ProgressBar IsIndeterminate="True" Margin="0,6,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            <Expander Header="{l:Loc Bench_Output}" Margin="0,6,0,0">
                <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" Height="180" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextWrapping="NoWrap" />
            </Expander>

            <!-- Отчёты -->
            <DockPanel Margin="0,20,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="HTML" Command="{Binding ExportCommand}" CommandParameter="html" />
                    <Button Content="Markdown" Command="{Binding ExportCommand}" CommandParameter="md" Margin="4,0,0,0" />
                    <Button Content="CSV" Command="{Binding ExportCommand}" CommandParameter="csv" Margin="4,0,0,0" />
                    <Button Content="JSON" Command="{Binding ExportCommand}" CommandParameter="json" Margin="4,0,0,0" />
                    <Button Style="{DynamicResource SubtleButtonStyle}" Command="{Binding OpenFolderCommand}" Margin="4,0,0,0" ToolTip="{l:Loc Settings_OpenData}">
                        <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                    </Button>
                </StackPanel>
                <TextBlock Text="{l:Loc Bench_Reports}" Style="{StaticResource SubtitleText}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{l:Loc Bench_ReportsHint}" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding Reports}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ReportItem}">
                        <Border Style="{StaticResource SettingCard}" Padding="12,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{DynamicResource SubtleButtonStyle}" ToolTip="{l:Loc Common_Remove}"
                                        Command="{Binding DataContext.DeleteReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <Path Data="{StaticResource IconTrash}" Style="{StaticResource IconPath}" />
                                </Button>
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                </CheckBox>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Сравнение -->
            <TextBlock Text="{l:Loc Bench_Compare}" Style="{StaticResource SubtitleText}" Margin="0,16,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding CompareHeaders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource CaptionText}">
                                    <Run Text="●" Foreground="{DynamicResource AccentBrush}" /> <Run Text="{Binding Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Comparison}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CompareRow}">
                                <DockPanel Margin="0,3">
                                    <TextBlock Width="180" FontWeight="SemiBold">
                                        <Run Text="{Binding Test, Mode=OneWay}" /> <Run Text="{Binding Unit, Mode=OneWay, StringFormat=' ({0})'}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Values}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Width="150" FontFamily="{DynamicResource MonoFontFamily}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
