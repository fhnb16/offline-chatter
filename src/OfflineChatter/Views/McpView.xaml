<UserControl x:Class="OfflineChatter.Views.McpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OfflineChatter.ViewModels"
             xmlns:l="clr-namespace:OfflineChatter.Localization">
    <UserControl.Resources>
        <DataTemplate x:Key="ToolRow" DataType="{x:Type vm:ToolItem}">
            <DockPanel Margin="0,3">
                <ComboBox DockPanel.Dock="Right" Width="170" ItemsSource="{Binding DataContext.ConsentOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding Mode}" DisplayMemberPath="Title" VerticalAlignment="Center" />
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFontFamily}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{l:Loc Nav_Mcp}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{l:Loc Mcp_Hint}" Style="{StaticResource CaptionText}" Margin="0,0,0,12" />

            <!-- ===== Общие ===== -->
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <CheckBox Content="{l:Loc Tools_EnabledByDefault}" IsChecked="{Binding EnabledByDefault}" />
                    <DockPanel Margin="0,10,0,0">
                        <TextBox DockPanel.Dock="Right" Width="70" Text="{Binding MaxSteps}" />
                        <TextBlock Text="{l:Loc Tools_MaxStepsLabel}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ===== Встроенные ===== -->
            <TextBlock Text="{l:Loc Tools_Builtin}" Style="{StaticResource SubtitleText}" Margin="0,16,0,8" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Builtins}" ItemTemplate="{StaticResource ToolRow}" />
                    <TextBlock Text="{l:Loc Tools_Sandbox}" Style="{StaticResource CaptionText}" Margin="0,12,0,2" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{l:Loc Common_Browse}" Command="{Binding PickSandboxCommand}" Margin="6,0,0,0" />
                        <TextBox Text="{Binding FileSandbox}" />
                    </DockPanel>
                    <TextBlock Text="{l:Loc Tools_Searxng}" Style="{StaticResource CaptionText}" Margin="0,10,0,2" />
                    <TextBox Text="{Binding SearxngUrl}" ToolTip="http://127.0.0.1:8888" />
                </StackPanel>
            </Border>

            <!-- ===== MCP-серверы ===== -->
            <DockPanel Margin="0,16,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{l:Loc Mcp_Import}" Command="{Binding ImportClaudeCommand}" />
                    <Button Content="{l:Loc Mcp_OpenConfig}" Command="{Binding OpenConfigCommand}" Margin="6,0,0,0" />
                    <Button Style="{DynamicResource SubtleButtonStyle}" Command="{Binding ReloadCommand}" Margin="6,0,0,0" ToolTip="{l:Loc Common_Refresh}">
                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPath}" />
                    </Button>
                </StackPanel>
                <TextBlock Text="{l:Loc Mcp_Servers}" Style="{StaticResource SubtitleText}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" Margin="0,0,0,6" Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock Text="{l:Loc Mcp_None}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                       Visibility="{Binding HasServers, Converter={StaticResource InverseBoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Servers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:McpServerItem}">
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <CheckBox Content="{l:Loc Providers_Enabled}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Content="{l:Loc Mcp_Connect}" Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <Button Content="{l:Loc Mcp_Disconnect}" Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{DynamicResource SubtleButtonStyle}" Margin="6,0,0,0" ToolTip="{l:Loc Common_Remove}"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconTrash}" Style="{StaticResource IconPath}" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Transport, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Target}" Style="{StaticResource CaptionText}" FontFamily="{DynamicResource MonoFontFamily}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock x:Name="St" Text="{Binding Status}" Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                </DockPanel>
                                <Expander Header="{l:Loc Mcp_Tools}" Margin="0,6,0,0" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding Tools}" ItemTemplate="{StaticResource ToolRow}" />
                                </Expander>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter TargetName="St" Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Добавить ===== -->
            <TextBlock Text="{l:Loc Mcp_AddTitle}" Style="{StaticResource SubtitleText}" Margin="0,16,0,8" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Text="{l:Loc Mcp_Name}" Style="{StaticResource CaptionText}" />
                    <TextBox Text="{Binding NewName}" Width="260" HorizontalAlignment="Left" />
                    <TextBlock Text="{l:Loc Mcp_Command}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding NewCommand}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip="npx -y @modelcontextprotocol/server-filesystem C:\Docs" />
                    <TextBlock Text="{l:Loc Mcp_Url}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding NewUrl}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip="https://example.com/mcp" />
                    <TextBlock Text="{l:Loc Tools_ExternalWarning}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusWarnBrush}" Margin="0,8,0,0" />
                    <Button Style="{DynamicResource AccentButtonStyle}" Content="{l:Loc Providers_Add}" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding ConfigPath, StringFormat='mcp.json: {0}'}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
