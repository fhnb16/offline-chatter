<UserControl x:Class="OfflineChatter.Views.InspectorLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OfflineChatter.Localization"
             xmlns:c="clr-namespace:OfflineChatter.Controls">
    <!--
        DataContext: InspectorLayoutViewModel. Выбор блоков правой панели чата — один и тот же список
        в «Настройки → Чат» и в мастере первого запуска. На широком окне — две колонки, на узком — одна.
    -->
    <StackPanel>
        <c:ResponsiveGrid MinColumnWidth="260" MaxColumns="2" Spacing="24">
            <StackPanel>
                <TextBlock Text="{l:Loc Inspector_GroupChat}" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding ChatItems}" ItemTemplate="{StaticResource InspectorToggleDetailedTemplate}" Focusable="False" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{l:Loc Res_Title}" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding ServerItems}" ItemTemplate="{StaticResource InspectorToggleDetailedTemplate}" Focusable="False" />
            </StackPanel>
        </c:ResponsiveGrid>
        <WrapPanel Margin="0,12,0,0">
            <Button Content="{l:Loc Inspector_Reset}" Command="{Binding ResetCommand}" Margin="0,0,8,4" />
            <Button Style="{DynamicResource SubtleButtonStyle}" Content="{l:Loc Inspector_ShowAll}" Command="{Binding ShowAllCommand}" Margin="0,0,8,4" />
        </WrapPanel>
    </StackPanel>
</UserControl>
