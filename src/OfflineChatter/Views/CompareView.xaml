<UserControl x:Class="OfflineChatter.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OfflineChatter.ViewModels"
             xmlns:r="clr-namespace:OfflineChatter.Rendering"
             xmlns:l="clr-namespace:OfflineChatter.Localization">
    <UserControl.Resources>
        <DataTemplate x:Key="ModelItem" DataType="{x:Type vm:ModelOption}">
            <TextBlock TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="{Binding Group, Mode=OneWay, StringFormat='  {0}'}" Foreground="{DynamicResource TextTertiaryBrush}" />
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="Side" DataType="{x:Type vm:CompareSide}">
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding DataContext.Models, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding Model}" ItemTemplate="{StaticResource ModelItem}" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Stats}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}" />
                    <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <r:MarkdownView Markdown="{Binding Answer}" IsStreaming="{Binding IsStreaming}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,20">
        <TextBlock DockPanel.Dock="Top" Text="{l:Loc Nav_Compare}" Style="{StaticResource PageTitleText}" />
        <TextBlock DockPanel.Dock="Top" Text="{l:Loc Compare_Hint}" Style="{StaticResource CaptionText}" Margin="0,-8,0,12" />
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Command="{Binding StopCommand}" Padding="10,6" ToolTip="{l:Loc Chat_Stop}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <Path Data="{StaticResource IconStop}" Style="{StaticResource IconPath}" />
                    </Button>
                    <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding RunCommand}" Padding="10,6" Margin="6,0,0,0" ToolTip="{l:Loc Chat_Send}">
                        <Path Data="{StaticResource IconSend}" Style="{StaticResource IconPath}" />
                    </Button>
                </StackPanel>
                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="160"
                         Background="Transparent" BorderThickness="0" FontSize="14" VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentPresenter Content="{Binding Left}" ContentTemplate="{StaticResource Side}" />
            <ContentPresenter Grid.Column="2" Content="{Binding Right}" ContentTemplate="{StaticResource Side}" />
        </Grid>
    </DockPanel>
</UserControl>
