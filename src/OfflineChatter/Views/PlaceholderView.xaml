<UserControl x:Class="OfflineChatter.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OfflineChatter.Localization">
    <StackPanel Margin="32,24" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="{l:Loc Page_InProgress}" Style="{StaticResource CaptionText}" />
    </StackPanel>
</UserControl>
