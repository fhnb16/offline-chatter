<UserControl x:Class="OfflineChatter.Views.EngineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OfflineChatter.ViewModels"
             xmlns:views="clr-namespace:OfflineChatter.Views"
             xmlns:l="clr-namespace:OfflineChatter.Localization"
             xmlns:c="clr-namespace:OfflineChatter.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,32">
            <TextBlock Text="{l:Loc Nav_Engine}" Style="{StaticResource PageTitleText}" />

            <!-- ===== Обновление llama.cpp ===== -->
            <Border Style="{StaticResource SettingCard}" Visibility="{Binding HasEngineUpdate, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{l:Loc Engine_UpdateTitle}" Style="{StaticResource SubtitleText}" />
                    <TextBlock Text="{Binding EngineUpdateText}" Style="{StaticResource CaptionText}" Margin="0,2,0,10" />
                    <WrapPanel>
                        <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding UpdateEngineCommand}" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Style="{StaticResource IconPath}" />
                                <TextBlock Text="{l:Loc Engine_UpdateInstall}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource SubtleButtonStyle}" Command="{Binding SkipEngineUpdateCommand}" Content="{l:Loc Engine_UpdateSkip}" Margin="0,0,8,4" />
                    </WrapPanel>
                    <TextBlock Text="{Binding InstallStatus}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- ===== Сервер ===== -->
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding StopServerCommand}" Content="{l:Loc Engine_Stop}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Engine_Server}" Style="{StaticResource SubtitleText}" />
                            <Border Style="{StaticResource StatusPill}" Margin="10,0,0,0">
                                <TextBlock Text="{Binding ServerState}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding ServerDetails}" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                               Visibility="{Binding ServerDetails, Converter={StaticResource NullToCollapsed}}" />
                    <Expander Header="{l:Loc Engine_ServerLog}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBox Text="{Binding ServerCommandLine, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" Margin="0,0,0,6"
                                     Visibility="{Binding ServerCommandLine, Converter={StaticResource NullToCollapsed}}" />
                            <TextBox Text="{Binding ServerLogTail, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                                     FontFamily="{DynamicResource MonoFontFamily}" FontSize="11" Height="220"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                            <Button HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding RefreshLogCommand}" Content="{l:Loc Common_Refresh}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- ===== Профили запуска ===== -->
            <TextBlock Text="{l:Loc Profiles_Title}" Style="{StaticResource SubtitleText}" Margin="0,16,0,8" />
            <views:ProfilesView DataContext="{Binding Profiles}" />

            <!-- ===== Железо ===== -->
            <TextBlock Text="{l:Loc Engine_Hardware}" Style="{StaticResource SubtitleText}" Margin="0,16,0,8" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Text="{Binding HardwareSummary}" Style="{StaticResource BodyText}" LineHeight="20" />
                    <DockPanel Margin="0,10,0,0" Visibility="{Binding RuntimeWarning, Converter={StaticResource NullToCollapsed}}">
                        <Button DockPanel.Dock="Right" Command="{Binding InstallVcRuntimeCommand}" Content="{l:Loc Engine_GetVcRuntime}" />
                        <TextBlock Text="{Binding RuntimeWarning}" Style="{StaticResource BodyText}" Foreground="{DynamicResource StatusWarnBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ===== Установленные ===== -->
            <c:AdaptiveRow Margin="0,16,0,8" Breakpoint="640">
                <TextBlock Text="{l:Loc Engine_InstalledTitle}" Style="{StaticResource SubtitleText}" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button Command="{Binding CheckEngineUpdateCommand}" Margin="0,0,6,4">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPath}" />
                            <TextBlock Text="{l:Loc Engine_CheckUpdate}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CleanupCommand}" Margin="0,0,6,4" ToolTip="{l:Loc Engine_CleanupHint}"
                            Visibility="{Binding CanCleanup, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrash}" Style="{StaticResource IconPath}" />
                            <TextBlock Text="{l:Loc Engine_Cleanup}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddExternalCommand}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                            <TextBlock Text="{l:Loc Engine_AddExternal}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </c:AdaptiveRow>
            <CheckBox IsChecked="{Binding CheckEngineUpdates}" Margin="0,0,0,8">
                <TextBlock Text="{l:Loc Engine_CheckUpdatesOnStart}" Style="{StaticResource BodyText}" />
            </CheckBox>
            <TextBlock Text="{Binding EngineUpdateStatus}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                       Visibility="{Binding EngineUpdateStatus, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock Text="{Binding CleanupStatus}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                       Visibility="{Binding CleanupStatus, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock Text="{l:Loc Engine_NoneInstalled}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                       Visibility="{Binding HasInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Installed}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:EngineItemViewModel}">
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{l:Loc Engine_MakeActive}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.SetActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <Button Style="{DynamicResource SubtleButtonStyle}" ToolTip="{l:Loc Settings_OpenData}"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                                    </Button>
                                    <Button Style="{DynamicResource SubtleButtonStyle}" ToolTip="{l:Loc Common_Remove}"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconTrash}" Style="{StaticResource IconPath}" />
                                    </Button>
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0" Padding="7,1"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{l:Loc Engine_Active}" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource CaptionText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock x:Name="Health" Text="{Binding Health}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusOkBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HealthOk}" Value="False">
                                <Setter TargetName="Health" Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Загрузка ===== -->
            <TextBlock Text="{l:Loc Engine_Download}" Style="{StaticResource SubtitleText}" Margin="0,16,0,8" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Text="{l:Loc Engine_DownloadHint}" Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Tag, Mode=OneWay}" />
                                        <Run Text="{Binding PublishedAt, Mode=OneWay, StringFormat=' · {0:d}'}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}" DisplayMemberPath="Title" />
                        <Button Grid.Column="3" Style="{DynamicResource SubtleButtonStyle}" Margin="6,0,0,0" ToolTip="{l:Loc Common_Refresh}"
                                Command="{Binding RefreshReleasesCommand}">
                            <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPath}" />
                        </Button>
                    </Grid>
                    <CheckBox Content="{l:Loc Engine_ShowAll}" IsChecked="{Binding ShowAllVariants}" Margin="0,10,0,0" />
                    <c:AdaptiveRow Margin="0,10,0,0" ControlMinWidth="240">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Engine_BuildSource}" Style="{StaticResource BodyText}" />
                            <TextBlock Text="{l:Loc Engine_BuildSourceHint}" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding BuildSources}" SelectedItem="{Binding BuildSource}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </c:AdaptiveRow>
                    <StackPanel Margin="0,8,0,0" Visibility="{Binding IsCustomSource, Converter={StaticResource BoolToVisibility}}">
                        <TextBox Text="{Binding CustomBuildRepo, UpdateSourceTrigger=PropertyChanged, Delay=800}" FontFamily="{DynamicResource MonoFontFamily}"
                                 ToolTip="owner/repo" />
                        <TextBlock Text="{l:Loc Engine_CustomRepoHint}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusWarnBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Margin="0,10,0,0" Visibility="{Binding IsLoadingReleases, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ReleasesError}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusErrorBrush}"
                               Visibility="{Binding ReleasesError, Converter={StaticResource NullToCollapsed}}" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding InstallCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Style="{StaticResource IconPath}" />
                                <TextBlock Text="{l:Loc Engine_InstallButton}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Command="{Binding CancelInstallCommand}" Content="{l:Loc Common_Cancel}"
                                Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding InstallStatus}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <views:DownloadsView DataContext="{Binding Downloads}" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
