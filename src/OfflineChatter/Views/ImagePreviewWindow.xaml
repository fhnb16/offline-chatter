<Window x:Class="OfflineChatter.Views.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OfflineChatter.Localization"
        Width="960" Height="720" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFontFamily}" FontSize="13"
        UseLayoutRounding="True">
    <DockPanel Background="{DynamicResource ContentBackgroundBrush}">
        <!-- Панель действий -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <Button Command="{Binding CopyCommand}" Margin="8,0,0,0" AutomationProperties.Name="{l:Loc Preview_Copy}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconPath}" />
                            <TextBlock Text="{l:Loc Preview_Copy}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveCommand}" Margin="8,0,0,0" AutomationProperties.Name="{l:Loc Preview_Save}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDownload}" Style="{StaticResource IconPath}" />
                            <TextBlock Text="{l:Loc Preview_Save}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="OnZoomOut" ToolTip="{l:Loc Preview_ZoomOut}" AutomationProperties.Name="{l:Loc Preview_ZoomOut}">
                        <Path Data="M3,8 H13" Style="{StaticResource IconPath}" />
                    </Button>
                    <TextBlock x:Name="ZoomText" Style="{StaticResource StatText}" FontSize="12" Width="48" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" Click="OnZoomIn" ToolTip="{l:Loc Preview_ZoomIn}" AutomationProperties.Name="{l:Loc Preview_ZoomIn}">
                        <Path Data="{StaticResource IconPlus}" Style="{StaticResource IconPath}" />
                    </Button>
                    <Button Style="{DynamicResource SubtleButtonStyle}" Click="OnFit" Content="{l:Loc Preview_Fit}" Margin="8,0,0,0" />
                    <Button Style="{DynamicResource SubtleButtonStyle}" Click="OnActualSize" Content="{l:Loc Preview_ActualSize}" Margin="4,0,0,0" />
                    <TextBlock x:Name="Info" Style="{StaticResource StatText}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource CaptionText}" Margin="12,6"
                   Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />

        <!-- Изображение: колесо — масштаб, перетаскивание — сдвиг -->
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="OnWheel" PreviewMouseLeftButtonDown="OnDragStart" PreviewMouseMove="OnDragMove"
                      PreviewMouseLeftButtonUp="OnDragEnd" Cursor="SizeAll" Background="Transparent">
            <Image x:Name="Picture" Source="{Binding Image}" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.LayoutTransform>
                    <ScaleTransform x:Name="Scale" />
                </Image.LayoutTransform>
            </Image>
        </ScrollViewer>
    </DockPanel>
</Window>
