<Window x:Class="OfflineChatter.Views.QuickAskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:OfflineChatter.Rendering"
        xmlns:l="clr-namespace:OfflineChatter.Localization"
        Title="{l:Loc Tray_QuickAsk}" Width="640" Height="420" MinHeight="200" MinWidth="420"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource AppFontSize}" UseLayoutRounding="True">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="ApplicationCommands.Close" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close" Executed="OnClose" />
    </Window.CommandBindings>
    <Border Background="{DynamicResource ContentBackgroundBrush}" Padding="14">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="6">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Click="OnAsk" Padding="10,6" ToolTip="{l:Loc Chat_Send}">
                        <Path Data="{StaticResource IconSend}" Style="{StaticResource IconPath}" />
                    </Button>
                    <Grid Margin="4,0">
                        <TextBox x:Name="Input" FontSize="{DynamicResource LargeFontSize}" Background="Transparent" BorderThickness="0" AcceptsReturn="False" VerticalContentAlignment="Center"
                                 KeyDown="OnInputKeyDown" />
                        <TextBlock Text="{l:Loc QuickAsk_Placeholder}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="{DynamicResource LargeFontSize}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Visibility="{Binding Text, ElementName=Input, Converter={StaticResource EmptyToVisible}}" />
                    </Grid>
                </DockPanel>
            </Border>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" x:Name="OpenInChat" Content="{l:Loc QuickAsk_OpenInChat}" Click="OnOpenInChat" IsEnabled="False" />
                <TextBlock x:Name="Status" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <ScrollViewer x:Name="Scroll" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <r:MarkdownView x:Name="Answer" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
