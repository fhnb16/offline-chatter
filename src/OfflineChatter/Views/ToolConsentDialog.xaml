<Window x:Class="OfflineChatter.Views.ToolConsentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OfflineChatter.Localization"
        Title="{l:Loc Tools_ConsentTitle}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource AppFontSize}" UseLayoutRounding="True">
    <Border Background="{DynamicResource ContentBackgroundBrush}" Padding="20,16">
        <StackPanel>
            <TextBlock x:Name="Header" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
            <TextBlock x:Name="Source" Style="{StaticResource CaptionText}" Margin="0,4,0,10" />
            <TextBlock Text="{l:Loc Tools_Arguments}" Style="{StaticResource CaptionText}" />
            <TextBox x:Name="Args" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                     FontFamily="{DynamicResource MonoFontFamily}" FontSize="{DynamicResource CaptionFontSize}" Margin="0,4,0,12" VerticalContentAlignment="Top" />
            <TextBlock x:Name="Warning" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusWarnBrush}" Margin="0,0,0,12" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:Loc Tools_Deny}" Click="OnDeny" IsCancel="True" MinWidth="100" />
                <Button Content="{l:Loc Tools_AllowAlways}" Click="OnAlways" Margin="8,0,0,0" MinWidth="120" />
                <Button Content="{l:Loc Tools_AllowOnce}" Click="OnOnce" Margin="8,0,0,0" MinWidth="120" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
