<UserControl x:Class="OfflineChatter.Views.ImagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OfflineChatter.ViewModels"
             xmlns:l="clr-namespace:OfflineChatter.Localization"
             xmlns:c="clr-namespace:OfflineChatter.Controls"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" PreviewKeyDown="OnPreviewKeyDown">
    <!-- DataContext: ImagesViewModel -->
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Visibility" Value="{DynamicResource UiHintVisibility}" />
        </Style>
        <DataTemplate x:Key="EnumItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,32">
            <c:AdaptiveRow Breakpoint="560" Margin="0,0,0,0">
                <TextBlock Text="{l:Loc Nav_Images}" Style="{StaticResource PageTitleText}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="{l:Loc Ui_DetailShort}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Main.DetailLevels}" SelectedItem="{Binding Main.Detail}" MinWidth="140"
                              ItemTemplate="{StaticResource EnumItemTemplate}" ToolTip="{l:Loc Ui_DetailHint}" />
                </StackPanel>
            </c:AdaptiveRow>
            <TextBlock Text="{l:Loc Img_PageIntro}" Style="{StaticResource CaptionText}" Margin="0,-8,0,12" Visibility="{DynamicResource UiHintVisibility}" />

            <!-- ===== Что нужно для начала: движок и модель ===== -->
            <Border Style="{StaticResource NoticeCard}" Visibility="{Binding IsSetupNeeded, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{l:Loc Img_SetupTitle}" Style="{StaticResource SubtitleText}" />
                    <TextBlock Text="{l:Loc Img_SetupIntro}" Style="{StaticResource CaptionText}" Margin="0,2,0,8" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" VerticalAlignment="Top" Margin="0,2,0,0"
                              Visibility="{Binding HasEngine, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{l:Loc Img_Step1}" Style="{StaticResource StatText}" VerticalAlignment="Top" Margin="4,2,0,0"
                                   Visibility="{Binding HasEngine, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{l:Loc Img_StepEngine}" Style="{StaticResource BodyText}" />
                            <TextBlock Text="{l:Loc Img_StepEngineHint}" Style="{StaticResource FieldHint}" Margin="0" />
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding OpenEngineCommand}" Content="{l:Loc Img_InstallEngine}" VerticalAlignment="Top" Margin="8,0,0,0"
                                Visibility="{Binding HasEngine, Converter={StaticResource InverseBoolToVisibility}}" />

                        <Path Grid.Row="2" Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" VerticalAlignment="Top" Margin="0,2,0,0"
                              Visibility="{Binding HasReadyModel, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Row="2" Text="{l:Loc Img_Step2}" Style="{StaticResource StatText}" VerticalAlignment="Top" Margin="4,2,0,0"
                                   Visibility="{Binding HasReadyModel, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="{l:Loc Img_StepModel}" Style="{StaticResource BodyText}" />
                            <TextBlock Text="{l:Loc Img_StepModelHint}" Style="{StaticResource FieldHint}" Margin="0" />
                            <TextBlock Text="{Binding SelectedModel.MissingText}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusWarnBrush}"
                                       Visibility="{Binding SelectedModel.MissingText, Converter={StaticResource NullToCollapsed}, FallbackValue=Collapsed}" />
                        </StackPanel>
                        <Button Grid.Row="2" Grid.Column="2" Command="{Binding OpenModelsCommand}" Content="{l:Loc Img_GetModel}" VerticalAlignment="Top" Margin="8,0,0,0"
                                Visibility="{Binding HasReadyModel, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>
                </StackPanel>
            </Border>

            <c:ResponsiveGrid MinColumnWidth="380" MaxColumns="2">
                <!-- ===== Параметры ===== -->
                <Border Style="{StaticResource Card}" Padding="16,12" VerticalAlignment="Top">
                    <StackPanel>
                        <!-- Модель и состояние генератора -->
                        <TextBlock Text="{l:Loc Img_Model}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="6,0,0,0" Command="{Binding OpenModelsCommand}" ToolTip="{l:Loc Img_GetModel}">
                                <Path Data="{StaticResource IconPlus}" Style="{StaticResource IconPath}" />
                            </Button>
                            <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ImageModelItem}">
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="{Binding FamilyTitle, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Style="{DynamicResource SubtleButtonStyle}" Command="{Binding StopServerCommand}" Content="{l:Loc Img_StopServer}"
                                    ToolTip="{l:Loc Img_StopServerHint}" Visibility="{Binding IsServerRunning, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="{l:Loc Img_Generator}" /><Run Text=": " /><Run Text="{Binding ServerStateText, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                        <TextBlock Text="{Binding PresetHint}" Style="{StaticResource FieldHint}"
                                   Visibility="{Binding PresetHint, Converter={StaticResource NullToCollapsed}}" />

                        <!-- Режим -->
                        <TextBlock Text="{l:Loc Img_Mode}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" ItemTemplate="{StaticResource EnumItemTemplate}" />
                        <TextBlock Text="{Binding ModeHint}" Style="{StaticResource FieldHint}" />

                        <!-- Промпт -->
                        <TextBlock Text="{l:Loc Img_Prompt}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxHeight="220"
                                 FontFamily="{DynamicResource ChatFontFamily}" FontSize="{DynamicResource ChatFontSize}" />
                        <TextBlock Text="{l:Loc Img_PromptHint}" Style="{StaticResource FieldHint}" />
                        <StackPanel Visibility="{Binding ShowNegative, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{l:Loc Img_Negative}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding NegativePrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="120"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="{l:Loc Img_NegativeHint}" Style="{StaticResource FieldHint}" />
                        </StackPanel>

                        <!-- Референсы (редактирование) -->
                        <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{l:Loc Img_Refs}" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding RefImages}" ItemsPanel="{StaticResource WrapItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RefImageItem}">
                                        <Grid Margin="0,0,8,8" Width="88" Height="88" ToolTip="{Binding Name}">
                                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True">
                                                <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                            </Border>
                                            <Button Style="{StaticResource IconButton}" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2"
                                                    Background="{DynamicResource CardBackgroundBrush}" ToolTip="{l:Loc Common_Remove}"
                                                    Command="{Binding DataContext.RemoveRefCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel>
                                <Button Command="{Binding PickImagesCommand}" Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconAttach}" Style="{StaticResource IconPath}" />
                                        <TextBlock Text="{l:Loc Img_AddRefs}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding PasteImageCommand}" Content="{l:Loc Img_Paste}" Margin="0,0,8,4" />
                            </WrapPanel>
                            <TextBlock Text="{l:Loc Img_RefsHint}" Style="{StaticResource FieldHint}" />
                        </StackPanel>

                        <!-- Исходник (img2img) -->
                        <StackPanel Visibility="{Binding IsImg2ImgMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{l:Loc Img_Init}" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="88" Height="88" Margin="0,0,12,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True"
                                        Visibility="{Binding InitImage, Converter={StaticResource NullToCollapsed}}">
                                    <Image Source="{Binding InitImage.Thumb}" Stretch="UniformToFill" />
                                </Border>
                                <WrapPanel VerticalAlignment="Center">
                                    <Button Command="{Binding PickImagesCommand}" Content="{l:Loc Img_PickInitButton}" Margin="0,0,8,4" />
                                    <Button Command="{Binding PasteImageCommand}" Content="{l:Loc Img_Paste}" Margin="0,0,8,4" />
                                    <Button Command="{Binding ClearInitCommand}" Content="{l:Loc Common_Remove}" Margin="0,0,8,4"
                                            Visibility="{Binding InitImage, Converter={StaticResource NullToCollapsed}}" />
                                </WrapPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="{l:Loc Img_Strength}" /><Run Text="{Binding Strength, StringFormat=' {0:0.00}'}" />
                            </TextBlock>
                            <Slider Minimum="0.05" Maximum="1" Value="{Binding Strength}" SmallChange="0.05" LargeChange="0.1" />
                            <TextBlock Text="{l:Loc Img_StrengthHint}" Style="{StaticResource FieldHint}" />
                        </StackPanel>

                        <!-- Размер -->
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <Run Text="{l:Loc Img_Size}" /><Run Text="{Binding SizeText, Mode=OneWay, StringFormat=' {0}'}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Aspects}" ItemsPanel="{StaticResource WrapItems}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AspectOption}">
                                    <Button Content="{Binding Label}" Margin="0,0,4,4" Padding="8,2" ToolTip="{Binding Tip}"
                                            Command="{Binding DataContext.SetAspectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,4,0,0" Visibility="{DynamicResource UiAdvancedVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Width}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip="{l:Loc Img_Width}" />
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="4,0" Command="{Binding SwapSizeCommand}" ToolTip="{l:Loc Img_Swap}">
                                <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPath}" />
                            </Button>
                            <TextBox Grid.Column="2" Text="{Binding Height}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip="{l:Loc Img_Height}" />
                        </Grid>
                        <TextBlock Text="{l:Loc Img_SizeHint}" Style="{StaticResource FieldHint}" />

                        <!-- Шаги и CFG -->
                        <c:ResponsiveGrid MinColumnWidth="160" MaxColumns="2" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="{l:Loc Img_Steps}" /><Run Text="{Binding Steps, StringFormat=' {0}'}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </TextBlock>
                                <Slider Minimum="1" Maximum="60" Value="{Binding Steps}" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" />
                                <TextBlock Text="{l:Loc Img_StepsHint}" Style="{StaticResource FieldHint}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="{l:Loc Img_Cfg}" /><Run Text="{Binding Cfg, StringFormat=' {0:0.0}'}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </TextBlock>
                                <Slider Minimum="1" Maximum="15" Value="{Binding Cfg}" TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="1" />
                                <TextBlock Text="{l:Loc Img_CfgHint}" Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </c:ResponsiveGrid>

                        <!-- Дополнительно -->
                        <Expander Header="{l:Loc Img_Advanced}" Margin="0,12,0,0" IsExpanded="{DynamicResource UiAdvancedExpanded}"
                                  Visibility="{DynamicResource UiAdvancedVisibility}">
                            <StackPanel>
                                <c:ResponsiveGrid MinColumnWidth="160" MaxColumns="2">
                                    <StackPanel>
                                        <TextBlock Text="{l:Loc Img_Sampler}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding Samplers}" SelectedItem="{Binding Sampler}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{l:Loc Img_Scheduler}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding Schedulers}" SelectedItem="{Binding Scheduler}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{l:Loc Img_Seed}" Style="{StaticResource FieldLabel}" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="4,0,0,0" Command="{Binding RandomSeedCommand}" ToolTip="{l:Loc Img_RandomSeed}">
                                                <Path Data="{StaticResource IconRetry}" Style="{StaticResource IconPath}" />
                                            </Button>
                                            <TextBox Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip="{l:Loc Img_SeedHint}" />
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{l:Loc Img_Batch}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding BatchOptions}" SelectedItem="{Binding BatchCount}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding ShowFlowShift, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{l:Loc Img_FlowShift}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding FlowShift}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip="{l:Loc Img_FlowShiftHint}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{l:Loc Img_ClipSkip}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding ClipSkip}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip="{l:Loc Img_ClipSkipHint}" />
                                    </StackPanel>
                                </c:ResponsiveGrid>
                                <TextBlock Text="{l:Loc Img_SeedHint}" Style="{StaticResource FieldHint}" />
                                <Button Command="{Binding ResetToPresetCommand}" Content="{l:Loc Img_ResetPreset}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        ToolTip="{l:Loc Img_ResetPresetHint}" />
                            </StackPanel>
                        </Expander>

                        <!-- Запуск -->
                        <WrapPanel Margin="0,16,0,0">
                            <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding GenerateCommand}" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlay}" Style="{StaticResource IconPath}" />
                                    <TextBlock Text="{l:Loc Img_Generate}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CancelCommand}" Content="{l:Loc Common_Cancel}" Margin="0,0,8,4"
                                    Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}" ToolTip="{l:Loc Img_CancelHint}" />
                        </WrapPanel>
                        <StackPanel Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                            <ProgressBar Height="6" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate}" />
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ElapsedText}" Style="{StaticResource StatText}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource StatText}" Visibility="{Binding ProgressText, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                   Visibility="{Binding IsGenerating, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBlock Text="{Binding Error}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="{Binding ServerError}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   MaxHeight="120" Visibility="{Binding ServerError, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="{Binding LastStats}" Style="{StaticResource StatText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding LastStats, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <!-- ===== Результат и галерея ===== -->
                <Border Style="{StaticResource Card}" Padding="16,12" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{DynamicResource SubtleButtonStyle}" Command="{Binding OpenFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                                    <TextBlock Text="{l:Loc Img_OpenFolder}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{l:Loc Img_Results}" Style="{StaticResource SubtitleText}" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="{l:Loc Img_NoResults}" Style="{StaticResource CaptionText}" Margin="0,12,0,0"
                                   Visibility="{Binding HasGallery, Converter={StaticResource InverseBoolToVisibility}}" />

                        <StackPanel Visibility="{Binding HasSelectedImage, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="OnPreviewClick" ToolTip="{Binding SelectedImage.Tooltip}">
                                <Image Source="{Binding SelectedPreview}" Stretch="Uniform" MaxHeight="520" />
                            </Border>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource IconButton}" Command="{Binding OpenImageCommand}" CommandParameter="{Binding SelectedImage}" ToolTip="{l:Loc Img_Open}">
                                    <Path Data="{StaticResource IconEye}" Style="{StaticResource IconPath}" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Command="{Binding CopyImageCommand}" CommandParameter="{Binding SelectedImage}" ToolTip="{l:Loc Img_Copy}">
                                    <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconPath}" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Command="{Binding SaveImageAsCommand}" CommandParameter="{Binding SelectedImage}" ToolTip="{l:Loc Img_SaveAs}">
                                    <Path Data="{StaticResource IconExport}" Style="{StaticResource IconPath}" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Command="{Binding ShowInFolderCommand}" CommandParameter="{Binding SelectedImage}" ToolTip="{l:Loc Img_ShowInFolder}">
                                    <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Command="{Binding DeleteImageCommand}" CommandParameter="{Binding SelectedImage}" ToolTip="{l:Loc Common_Remove}">
                                    <Path Data="{StaticResource IconTrash}" Style="{StaticResource IconPath}" />
                                </Button>
                                <Button Command="{Binding UseAsRefCommand}" CommandParameter="{Binding SelectedImage}" Content="{l:Loc Img_UseAsRef}" Margin="8,0,0,0"
                                        ToolTip="{l:Loc Img_UseAsRefHint}" />
                                <Button Command="{Binding ReuseParamsCommand}" CommandParameter="{Binding SelectedImage}" Content="{l:Loc Img_Reuse}" Margin="8,0,0,0"
                                        ToolTip="{l:Loc Img_ReuseHint}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding SelectedImage.Tooltip}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="64" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Gallery}" SelectedItem="{Binding SelectedImage}" Margin="0,12,0,0" MaxHeight="300"
                                 BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding HasGallery, Converter={StaticResource BoolToVisibility}}" MouseDoubleClick="OnGalleryDoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="2" />
                                    <Setter Property="Margin" Value="0,0,4,4" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GalleryItem}">
                                    <Image Source="{Binding Thumb}" Width="88" Height="88" Stretch="UniformToFill" ToolTip="{Binding Tooltip}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </c:ResponsiveGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
