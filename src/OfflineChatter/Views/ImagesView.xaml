<UserControl x:Class="OfflineChatter.Views.ImagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OfflineChatter.ViewModels"
             xmlns:l="clr-namespace:OfflineChatter.Localization"
             xmlns:c="clr-namespace:OfflineChatter.Controls"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" PreviewKeyDown="OnPreviewKeyDown">
    <!-- DataContext: ImagesViewModel -->
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Visibility" Value="{DynamicResource UiHintVisibility}" />
        </Style>
        <Style x:Key="WarnText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource StatusWarnBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <DataTemplate x:Key="EnumItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
        </DataTemplate>
        <DataTemplate x:Key="EmptyTemplate" />
        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <!-- Страница не прокручивается целиком: слева параметры со своей прокруткой и закреплённой кнопкой запуска,
         справа превью и готовые картинки — всегда на виду -->
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
            <c:AdaptiveRow Breakpoint="560" Margin="0,0,0,0">
                <TextBlock Text="{l:Loc Nav_Images}" Style="{StaticResource PageTitleText}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="{l:Loc Ui_DetailShort}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Main.DetailLevels}" SelectedItem="{Binding Main.Detail}" MinWidth="140"
                              ItemTemplate="{StaticResource EnumItemTemplate}" ToolTip="{l:Loc Ui_DetailHint}" />
                </StackPanel>
            </c:AdaptiveRow>
            <TextBlock Grid.Row="1" Text="{l:Loc Img_PageIntro}" Style="{StaticResource CaptionText}" Margin="0,-8,0,12" Visibility="{DynamicResource UiHintVisibility}" />

            <!-- ===== Что нужно для начала: движок и модель ===== -->
            <Border Grid.Row="2" Style="{StaticResource NoticeCard}" Visibility="{Binding IsSetupNeeded, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{l:Loc Img_SetupTitle}" Style="{StaticResource SubtitleText}" />
                    <TextBlock Text="{l:Loc Img_SetupIntro}" Style="{StaticResource CaptionText}" Margin="0,2,0,8" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" VerticalAlignment="Top" Margin="0,2,0,0"
                              Visibility="{Binding HasEngine, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{l:Loc Img_Step1}" Style="{StaticResource StatText}" VerticalAlignment="Top" Margin="4,2,0,0"
                                   Visibility="{Binding HasEngine, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{l:Loc Img_StepEngine}" Style="{StaticResource BodyText}" />
                            <TextBlock Text="{l:Loc Img_StepEngineHint}" Style="{StaticResource FieldHint}" Margin="0" />
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding OpenEngineCommand}" Content="{l:Loc Img_InstallEngine}" VerticalAlignment="Top" Margin="8,0,0,0"
                                Visibility="{Binding HasEngine, Converter={StaticResource InverseBoolToVisibility}}" />

                        <Path Grid.Row="2" Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" VerticalAlignment="Top" Margin="0,2,0,0"
                              Visibility="{Binding HasReadyModel, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Row="2" Text="{l:Loc Img_Step2}" Style="{StaticResource StatText}" VerticalAlignment="Top" Margin="4,2,0,0"
                                   Visibility="{Binding HasReadyModel, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="{l:Loc Img_StepModel}" Style="{StaticResource BodyText}" />
                            <TextBlock Text="{l:Loc Img_StepModelHint}" Style="{StaticResource FieldHint}" Margin="0" />
                            <TextBlock Text="{Binding SelectedModel.MissingText}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusWarnBrush}"
                                       Visibility="{Binding SelectedModel.MissingText, Converter={StaticResource NullToCollapsed}, FallbackValue=Collapsed}" />
                        </StackPanel>
                        <Button Grid.Row="2" Grid.Column="2" Command="{Binding OpenModelsCommand}" Content="{l:Loc Img_GetModel}" VerticalAlignment="Top" Margin="8,0,0,0"
                                Visibility="{Binding HasReadyModel, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Перетащили картинку с параметрами программы ===== -->
            <Border Grid.Row="3" Style="{StaticResource NoticeCard}" Visibility="{Binding HasDroppedParams, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Command="{Binding RestoreDroppedParamsCommand}" Content="{l:Loc Img_RestoreParams}" Margin="8,0,0,4" />
                        <Button Command="{Binding DismissDroppedParamsCommand}" Content="{l:Loc Common_Close}" Margin="8,0,0,4" />
                    </WrapPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:Loc Img_DroppedParams}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DroppedParams.Prompt}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <c:SplitPanel Grid.Row="4" Spacing="12" StackedRatio="0.5">
                <!-- ===== Параметры: своя прокрутка, запуск закреплён снизу ===== -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <!-- Запуск: виден при любом положении прокрутки -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                            <StackPanel>
                                <WrapPanel>
                                    <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding GenerateCommand}" Margin="0,0,8,4" ToolTip="Ctrl+Enter">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconPlay}" Style="{StaticResource IconPath}" />
                                            <TextBlock Text="{l:Loc Img_Generate}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding Final2KCommand}" Content="{l:Loc Img_Final2K}" Margin="0,0,8,4" ToolTip="{l:Loc Img_Final2KHint}"
                                            Visibility="{Binding CanFinal2K, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Command="{Binding CancelCommand}" Content="{l:Loc Common_Cancel}" Margin="0,0,8,4"
                                            Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}" ToolTip="{l:Loc Img_CancelHint}" />
                                </WrapPanel>
                                <StackPanel Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ElapsedText}" Style="{StaticResource StatText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource StatText}" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" Visibility="{Binding ProgressText, Converter={StaticResource NullToCollapsed}}" />
                                    <ProgressBar Style="{DynamicResource ProgressBarStyle}" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate}"
                                                 Margin="0,4,0,0" AutomationProperties.Name="{Binding Status}" AutomationProperties.HelpText="{Binding ProgressText}" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsGenerating, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                                <!-- Ошибки — у кнопки, которая к ним привела; длинный текст целиком в подсказке -->
                                <TextBlock Text="{Binding Error}" ToolTip="{Binding Error}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusErrorBrush}"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="112" Margin="0,4,0,0"
                                           Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
                                <TextBlock Text="{Binding ServerError}" ToolTip="{Binding ServerError}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusErrorBrush}"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="64" Margin="0,4,0,0"
                                           Visibility="{Binding ServerError, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,12,16,16">
                            <!-- Модель и состояние генератора -->
                            <TextBlock Text="{l:Loc Img_Model}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="6,0,0,0" Command="{Binding OpenModelsCommand}" ToolTip="{l:Loc Img_GetModel}">
                                    <Path Data="{StaticResource IconPlus}" Style="{StaticResource IconPath}" />
                                </Button>
                                <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ImageModelItem}">
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="{Binding FamilyTitle, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Style="{DynamicResource SubtleButtonStyle}" Command="{Binding StopServerCommand}" Content="{l:Loc Img_StopServer}"
                                        ToolTip="{l:Loc Img_StopServerHint}" Visibility="{Binding IsServerRunning, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="{l:Loc Img_Generator}" /><Run Text=": " /><Run Text="{Binding ServerStateText, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                            <TextBlock Text="{Binding PresetHint}" Style="{StaticResource FieldHint}"
                                       Visibility="{Binding PresetHint, Converter={StaticResource NullToCollapsed}}" />

                            <!-- Режим: вкладки на одной загруженной модели -->
                            <TabControl Style="{DynamicResource TabStrip}" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Margin="0,12,0,0"
                                        ItemTemplate="{StaticResource EnumItemTemplate}" ContentTemplate="{StaticResource EmptyTemplate}" />
                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding ModeHint}" Style="{StaticResource FieldHint}" />

                            <!-- ===== Исходник, маска, сила (перерисовка) ===== -->
                            <StackPanel Visibility="{Binding IsImg2ImgMode, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{l:Loc Img_Init}" Style="{StaticResource FieldLabel}" />
                                <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}"
                                        ClipToBounds="True" HorizontalAlignment="Left" MaxHeight="360" Margin="0,0,0,8"
                                        Visibility="{Binding HasInit, Converter={StaticResource BoolToVisibility}}">
                                    <c:MaskCanvas Source="{Binding InitPreview}" PixelSize="{Binding InitPixelSize}" BrushFraction="{Binding BrushFraction}"
                                                  IsEraser="{Binding IsEraser}" MaskPng="{Binding MaskPng}" ToolTip="{l:Loc Img_MaskHint}" />
                                </Border>
                                <WrapPanel>
                                    <Button Command="{Binding PickImagesCommand}" Content="{l:Loc Img_PickInitButton}" Margin="0,0,8,4" />
                                    <Button Command="{Binding PasteImageCommand}" Content="{l:Loc Img_Paste}" Margin="0,0,8,4" />
                                    <Button Command="{Binding ClearInitCommand}" Content="{l:Loc Common_Remove}" Margin="0,0,8,4"
                                            Visibility="{Binding HasInit, Converter={StaticResource BoolToVisibility}}" />
                                </WrapPanel>

                                <!-- Кисть маски -->
                                <StackPanel Visibility="{Binding HasInit, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{l:Loc Img_Mask}" Style="{StaticResource FieldLabel}" />
                                    <c:AdaptiveRow ControlMinWidth="200">
                                        <TextBlock Text="{l:Loc Img_BrushSize}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                        <Slider Minimum="0.01" Maximum="0.2" Value="{Binding BrushFraction}" SmallChange="0.01" LargeChange="0.03" VerticalAlignment="Center" />
                                    </c:AdaptiveRow>
                                    <WrapPanel Margin="0,4,0,0">
                                        <CheckBox IsChecked="{Binding IsEraser}" Content="{l:Loc Img_Eraser}" Margin="0,0,16,4" VerticalAlignment="Center" />
                                        <CheckBox IsChecked="{Binding MaskInvert}" Content="{l:Loc Img_MaskInvert}" Margin="0,0,16,4" VerticalAlignment="Center" />
                                        <Button Command="{Binding ClearMaskCommand}" Content="{l:Loc Img_MaskClear}" Margin="0,0,8,4"
                                                Visibility="{Binding HasMask, Converter={StaticResource BoolToVisibility}}" />
                                    </WrapPanel>
                                    <TextBlock Text="{l:Loc Img_MaskHint}" Style="{StaticResource FieldHint}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="{l:Loc Img_Strength}" /><Run Text="{Binding Strength, StringFormat=' {0:0.00}'}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </TextBlock>
                                <Slider Minimum="0.05" Maximum="1" Value="{Binding Strength}" SmallChange="0.05" LargeChange="0.1" />
                                <TextBlock Text="{l:Loc Img_StrengthHint}" Style="{StaticResource FieldHint}" />

                                <StackPanel Visibility="{DynamicResource UiAdvancedVisibility}">
                                    <TextBlock Text="{l:Loc Img_Fit}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Fits}" SelectedItem="{Binding InitFit}" ItemTemplate="{StaticResource EnumItemTemplate}" />
                                    <TextBlock Text="{l:Loc Img_FitHint}" Style="{StaticResource FieldHint}" />
                                    <CheckBox IsChecked="{Binding InitCanny}" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{l:Loc Img_Canny}" Style="{StaticResource BodyText}" />
                                            <TextBlock Text="{l:Loc Img_CannyHint}" Style="{StaticResource FieldHint}" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </StackPanel>

                            <!-- ===== Референсы: правка и дополнительные в перерисовке ===== -->
                            <StackPanel Visibility="{Binding ShowRefs, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="{l:Loc Img_Refs}" /><Run Text="{Binding RefImages.Count, Mode=OneWay, StringFormat=' · {0}'}" />
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding RefImages}" ItemsPanel="{StaticResource WrapItems}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:RefImageItem}">
                                            <StackPanel Margin="0,0,8,8" Width="88">
                                                <Grid Width="88" Height="88" ToolTip="{Binding Tooltip}">
                                                    <c:CheckerBorder BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True">
                                                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                                    </c:CheckerBorder>
                                                    <!-- Номер: щелчок вставляет <image:N> в промпт -->
                                                    <Button HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2" MinWidth="24" Height="24" Padding="6,0"
                                                            Background="{DynamicResource CardBackgroundBrush}" ToolTip="{l:Loc Img_InsertTag}"
                                                            Command="{Binding DataContext.InsertTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding IndexText}" Style="{StaticResource StatText}" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2"
                                                            Background="{DynamicResource CardBackgroundBrush}" ToolTip="{l:Loc Common_Remove}"
                                                            Command="{Binding DataContext.RemoveRefCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="2"
                                                            Background="{DynamicResource CardBackgroundBrush}" ToolTip="{l:Loc Img_MakeFirst}"
                                                            Command="{Binding DataContext.MakeFirstRefCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPath}" />
                                                    </Button>
                                                </Grid>
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource StatText}" FontSize="{DynamicResource SmallFontSize}" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SentText}" Style="{StaticResource StatText}" FontSize="{DynamicResource SmallFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding SentText, Converter={StaticResource NullToCollapsed}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel>
                                    <Button Command="{Binding PickRefsCommand}" Margin="0,0,8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconAttach}" Style="{StaticResource IconPath}" />
                                            <TextBlock Text="{l:Loc Img_AddRefs}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding PasteImageCommand}" Content="{l:Loc Img_Paste}" Margin="0,0,8,4"
                                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}" />
                                </WrapPanel>
                                <TextBlock Text="{l:Loc Img_RefsHint}" Style="{StaticResource FieldHint}" />
                                <TextBlock Text="{l:Loc Img_RefsExtraHint}" Style="{StaticResource FieldHint}"
                                           Visibility="{Binding IsImg2ImgMode, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding RefScaleHint}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding RefScaleHint, Converter={StaticResource NullToCollapsed}}" />
                                <CheckBox IsChecked="{Binding LimitInputSize}" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{l:Loc Img_LimitInput}" Style="{StaticResource BodyText}" />
                                        <TextBlock Text="{l:Loc Img_LimitInputHint}" Style="{StaticResource FieldHint}" />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Text="{l:Loc Img_VisionMissing}" Style="{StaticResource WarnText}"
                                           Visibility="{Binding VisionMissing, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <!-- Промпт -->
                            <TextBlock Text="{l:Loc Img_Prompt}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxHeight="220"
                                     FontFamily="{DynamicResource ChatFontFamily}" FontSize="{DynamicResource ChatFontSize}" />
                            <TextBlock Text="{l:Loc Img_PromptHint}" Style="{StaticResource FieldHint}" />
                            <StackPanel Visibility="{Binding ShowPromptTags, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{l:Loc Img_TagsHint}" Style="{StaticResource FieldHint}" />
                                <TextBlock Text="{Binding PromptTagsText}" Style="{StaticResource StatText}" Margin="0,4,0,0"
                                           Visibility="{Binding PromptTagsText, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                            <Expander Header="{l:Loc Img_PromptHistory}" IsExpanded="{Binding IsPromptHistoryOpen}" Margin="0,8,0,0">
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="{l:Loc Img_PromptHistoryEmpty}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding HasPromptHistory, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <ScrollViewer MaxHeight="192" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding HasPromptHistory, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl ItemsSource="{Binding PromptHistory}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{DynamicResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                            FocusVisualStyle="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}"
                                                            Command="{Binding DataContext.RestorePromptCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" ToolTip="{Binding Prompt}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding PromptPreview}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding NegativePromptPreview}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Visibility="{Binding HasNegativePrompt, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Expander>
                            <CheckBox IsChecked="{Binding Transparent}" Margin="0,8,0,0" Visibility="{Binding ShowTransparent, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{l:Loc Img_Transparent}" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="{l:Loc Img_TransparentHint}" Style="{StaticResource FieldHint}" />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Visibility="{Binding ShowNegative, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{l:Loc Img_Negative}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding NegativePrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="120"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                                <TextBlock Text="{l:Loc Img_NegativeHint}" Style="{StaticResource FieldHint}" />
                            </StackPanel>

                            <!-- Размер -->
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="{l:Loc Img_Size}" /><Run Text="{Binding SizeText, Mode=OneWay, StringFormat=' {0}'}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </TextBlock>
                            <WrapPanel>
                                <CheckBox IsChecked="{Binding SizeFromRef}" Content="{l:Loc Img_SizeFromRef}" Margin="0,0,16,6" ToolTip="{l:Loc Img_SizeFromRefHint}"
                                          Visibility="{Binding ShowSizeFromRef, Converter={StaticResource BoolToVisibility}}" />
                                <CheckBox IsChecked="{Binding Is2K}" Content="{l:Loc Img_Size2K}" Margin="0,0,16,6" ToolTip="{l:Loc Img_Size2KHint}" />
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding Aspects}" ItemsPanel="{StaticResource WrapItems}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AspectOption}">
                                        <Button Content="{Binding Label}" Margin="0,0,4,4" Padding="8,2" ToolTip="{Binding Tip}"
                                                Command="{Binding DataContext.SetAspectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,4,0,0" Visibility="{DynamicResource UiAdvancedVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Width}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip="{l:Loc Img_Width}" />
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="4,0" Command="{Binding SwapSizeCommand}" ToolTip="{l:Loc Img_Swap}">
                                    <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPath}" />
                                </Button>
                                <TextBox Grid.Column="2" Text="{Binding Height}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip="{l:Loc Img_Height}" />
                            </Grid>
                            <TextBlock Text="{l:Loc Img_SizeHint}" Style="{StaticResource FieldHint}" />

                            <!-- Шаги и CFG -->
                            <c:ResponsiveGrid MinColumnWidth="160" MaxColumns="2" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}">
                                        <Run Text="{l:Loc Img_Steps}" /><Run Text="{Binding Steps, StringFormat=' {0}'}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </TextBlock>
                                    <Slider Minimum="1" Maximum="60" Value="{Binding Steps}" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" />
                                    <TextBlock Text="{l:Loc Img_StepsHint}" Style="{StaticResource FieldHint}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}">
                                        <Run Text="{l:Loc Img_Cfg}" /><Run Text="{Binding Cfg, StringFormat=' {0:0.0}'}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </TextBlock>
                                    <Slider Minimum="1" Maximum="15" Value="{Binding Cfg}" TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="1" />
                                    <TextBlock Text="{l:Loc Img_CfgHint}" Style="{StaticResource FieldHint}" />
                                </StackPanel>
                            </c:ResponsiveGrid>

                            <!-- Предупреждения о сочетании параметров -->
                            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0" Focusable="False"
                                          Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource WarnText}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Дополнительно -->
                            <Expander Header="{l:Loc Img_Advanced}" Margin="0,12,0,0" IsExpanded="{DynamicResource UiAdvancedExpanded}"
                                      Visibility="{DynamicResource UiAdvancedVisibility}">
                                <StackPanel>
                                    <c:ResponsiveGrid MinColumnWidth="160" MaxColumns="2">
                                        <StackPanel>
                                            <TextBlock Text="{l:Loc Img_Sampler}" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding Samplers}" SelectedItem="{Binding Sampler}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{l:Loc Img_Scheduler}" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding Schedulers}" SelectedItem="{Binding Scheduler}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{l:Loc Img_Seed}" Style="{StaticResource FieldLabel}" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="4,0,0,0" Command="{Binding RandomSeedCommand}" ToolTip="{l:Loc Img_RandomSeed}">
                                                    <Path Data="{StaticResource IconRetry}" Style="{StaticResource IconPath}" />
                                                </Button>
                                                <TextBox Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip="{l:Loc Img_SeedHint}" />
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{l:Loc Img_Batch}" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding BatchOptions}" SelectedItem="{Binding BatchCount}" />
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding ShowFlowShift, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{l:Loc Img_FlowShift}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding FlowShift}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip="{l:Loc Img_FlowShiftHint}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{l:Loc Img_ClipSkip}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding ClipSkip}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip="{l:Loc Img_ClipSkipHint}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{l:Loc Img_StepCache}" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding CacheModes}" SelectedValuePath="Value" DisplayMemberPath="Title" SelectedValue="{Binding CacheMode}"
                                                      ToolTip="{l:Loc Img_StepCacheHint}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{l:Loc Img_PreviewMode}" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding PreviewModes}" SelectedValuePath="Value" DisplayMemberPath="Title" SelectedValue="{Binding PreviewMode}"
                                                      ToolTip="{l:Loc Img_PreviewModeHint}" />
                                        </StackPanel>
                                    </c:ResponsiveGrid>
                                    <TextBlock Text="{l:Loc Img_SeedHint}" Style="{StaticResource FieldHint}" />

                                    <TextBlock Text="{l:Loc Img_Sigmas}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Sigmas, UpdateSourceTrigger=PropertyChanged, Delay=500}" FontFamily="{DynamicResource MonoFontFamily}" TextWrapping="Wrap" />
                                    <TextBlock Text="{l:Loc Img_SigmasHint}" Style="{StaticResource FieldHint}" />

                                    <!-- LoRA -->
                                    <TextBlock Text="{l:Loc Img_Lora}" Style="{StaticResource FieldLabel}" />
                                    <StackPanel Visibility="{Binding HasLoraDir, Converter={StaticResource BoolToVisibility}}">
                                        <ComboBox ItemsSource="{Binding Loras}" SelectedValuePath="Value" DisplayMemberPath="Title" SelectedValue="{Binding SelectedLora}" />
                                        <TextBlock Style="{StaticResource FieldLabel}">
                                            <Run Text="{l:Loc Img_LoraStrength}" /><Run Text="{Binding LoraStrength, StringFormat=' {0:0.00}'}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </TextBlock>
                                        <Slider Minimum="0" Maximum="2" Value="{Binding LoraStrength}" SmallChange="0.05" LargeChange="0.25" />
                                        <TextBlock Text="{l:Loc Img_LoraHint}" Style="{StaticResource FieldHint}" />
                                    </StackPanel>
                                    <DockPanel Visibility="{Binding HasLoraDir, Converter={StaticResource InverseBoolToVisibility}}">
                                        <Button DockPanel.Dock="Right" Command="{Binding OpenEngineCommand}" Content="{l:Loc Img_LoraSetDir}" Margin="8,0,0,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{l:Loc Img_LoraNoDir}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                    </DockPanel>

                                    <Button Command="{Binding ResetToPresetCommand}" Content="{l:Loc Img_ResetPreset}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                            ToolTip="{l:Loc Img_ResetPresetHint}" />
                                </StackPanel>
                            </Expander>

                        </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ===== Превью и готовые картинки: всегда на виду, своя прокрутка у галереи ===== -->
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition MaxHeight="196">
                                <RowDefinition.Style>
                                    <Style TargetType="RowDefinition">
                                        <Setter Property="Height" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasGallery}" Value="True">
                                                <Setter Property="Height" Value="*" />
                                                <Setter Property="MinHeight" Value="40" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RowDefinition.Style>
                            </RowDefinition>
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{DynamicResource SubtleButtonStyle}" Command="{Binding OpenFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                                    <TextBlock Text="{l:Loc Img_OpenFolder}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{l:Loc Img_Results}" Style="{StaticResource SubtitleText}" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Область превью занимает всю свободную высоту; картинка вписывается целиком -->
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <!-- Пусто: ни кадра генерации, ни выбранной картинки -->
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Visibility="{Binding ShowPreviewPlaceholder, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                    <Path Data="{StaticResource IconImage}" Style="{StaticResource IconPath}" Stroke="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding PreviewPlaceholderText}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Живое превью по шагам -->
                            <c:CheckerBorder BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{l:Loc Img_LivePreview}"
                                             Visibility="{Binding ShowLivePreview, Converter={StaticResource BoolToVisibility}}">
                                <Image Source="{Binding LivePreview}" Stretch="Uniform" />
                            </c:CheckerBorder>

                            <!-- Сравнение «до / после» -->
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True"
                                    Visibility="{Binding ShowCompare, Converter={StaticResource BoolToVisibility}}">
                                <c:CompareView Before="{Binding SelectedImage.Before}" After="{Binding SelectedPreview}" ToolTip="{l:Loc Img_CompareHint}"
                                               AutomationProperties.Name="{l:Loc Img_Compare}" AutomationProperties.HelpText="{l:Loc Img_CompareHint}" />
                            </Border>

                            <!-- Выбранная картинка -->
                            <c:CheckerBorder BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}"
                                             ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="OnPreviewClick" ToolTip="{Binding SelectedImage.Tooltip}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Visibility="{Binding ShowSingle, Converter={StaticResource BoolToVisibility}}">
                                <Image Source="{Binding SelectedPreview}" Stretch="Uniform" />
                            </c:CheckerBorder>
                        </Grid>

                        <!-- Действия с картинкой и статистика последнего запуска -->
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="{l:Loc Img_LivePreview}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                       Visibility="{Binding ShowLivePreview, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel Visibility="{Binding ShowResultTools, Converter={StaticResource BoolToVisibility}}">
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource IconButton}" Command="{Binding OpenImageCommand}" CommandParameter="{Binding SelectedImage}" ToolTip="{l:Loc Img_Open}">
                                        <Path Data="{StaticResource IconEye}" Style="{StaticResource IconPath}" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Command="{Binding CopyImageCommand}" CommandParameter="{Binding SelectedImage}" ToolTip="{l:Loc Img_Copy}">
                                        <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconPath}" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Command="{Binding SaveImageAsCommand}" CommandParameter="{Binding SelectedImage}" ToolTip="{l:Loc Img_SaveAs}">
                                        <Path Data="{StaticResource IconExport}" Style="{StaticResource IconPath}" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Command="{Binding ShowInFolderCommand}" CommandParameter="{Binding SelectedImage}" ToolTip="{l:Loc Img_ShowInFolder}">
                                        <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Command="{Binding DeleteImageCommand}" CommandParameter="{Binding SelectedImage}" ToolTip="{l:Loc Common_Remove}">
                                        <Path Data="{StaticResource IconTrash}" Style="{StaticResource IconPath}" />
                                    </Button>
                                    <CheckBox IsChecked="{Binding IsComparing}" Content="{l:Loc Img_Compare}" Margin="12,0,0,0" VerticalAlignment="Center"
                                              Visibility="{Binding CanCompare, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Command="{Binding UseAsRefCommand}" CommandParameter="{Binding SelectedImage}" Content="{l:Loc Img_UseAsRef}" Margin="12,0,0,0"
                                            ToolTip="{l:Loc Img_UseAsRefHint}" />
                                    <Button Command="{Binding ReuseParamsCommand}" CommandParameter="{Binding SelectedImage}" Content="{l:Loc Img_Reuse}" Margin="8,0,0,0"
                                            ToolTip="{l:Loc Img_ReuseHint}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding SelectedImage.Tooltip}" ToolTip="{Binding SelectedImage.Tooltip}" Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" MaxHeight="48" />
                            </StackPanel>
                            <TextBlock Text="{Binding LastStats}" Style="{StaticResource StatText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding LastStats, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock Text="{Binding ConditioningText}" Style="{StaticResource StatText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding ConditioningText, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock Text="{Binding SlowHint}" Style="{StaticResource WarnText}"
                                       Visibility="{Binding SlowHint, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>

                        <!-- Галерея: своя прокрутка, не дальше двух рядов -->
                        <ListBox Grid.Row="3" ItemsSource="{Binding Gallery}" SelectedItem="{Binding SelectedImage}" Margin="0,8,0,0" Padding="0"
                                 BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding HasGallery, Converter={StaticResource BoolToVisibility}}" MouseDoubleClick="OnGalleryDoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,4,0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GalleryItem}">
                                    <Viewbox Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"
                                             MaxHeight="92" StretchDirection="DownOnly">
                                        <Image Source="{Binding Thumb}" Width="88" Height="88" Margin="2" Stretch="UniformToFill" ToolTip="{Binding Tooltip}" />
                                    </Viewbox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </c:SplitPanel>
    </Grid>
</UserControl>
