<UserControl x:Class="OfflineChatter.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OfflineChatter.ViewModels"
             xmlns:views="clr-namespace:OfflineChatter.Views"
             xmlns:r="clr-namespace:OfflineChatter.Rendering"
             xmlns:l="clr-namespace:OfflineChatter.Localization"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:MessageViewModel}">
            <Grid x:Name="Root" Margin="0,0,0,10" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="Bubble" HorizontalAlignment="Left" MaxWidth="820" Style="{StaticResource Card}" Padding="14,10">
                    <StackPanel>
                        <!-- Вложения -->
                        <ItemsControl ItemsSource="{Binding Attachments}" Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AttachmentView}">
                                    <Border Margin="0,0,6,6" CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" MaxHeight="160" MaxWidth="240" Stretch="Uniform" Cursor="Hand"
                                                   ToolTip="{l:Loc Preview_Open}"
                                                   Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                                                <Image.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                                                  Command="{Binding DataContext.PreviewAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </Image.InputBindings>
                                            </Image>
                                            <StackPanel Orientation="Horizontal" Margin="8,5" Visibility="{Binding IsImage, Converter={StaticResource InverseBoolToVisibility}}">
                                                <Path Data="{StaticResource IconAttach}" Style="{StaticResource IconPath}" />
                                                <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Рассуждения -->
                        <Expander x:Name="Think" Header="{Binding ReasoningHeader}" Margin="0,0,0,6"
                                  Visibility="{Binding HasReasoning, Converter={StaticResource BoolToVisibility}}">
                            <TextBox Text="{Binding Reasoning, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{DynamicResource ChatFontFamily}" FontSize="{DynamicResource ChatSmallFontSize}"
                                     Foreground="{DynamicResource TextSecondaryBrush}" Background="Transparent" BorderThickness="0" MinHeight="0" Padding="0"
                                     MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled" />
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </Expander>
                        <!-- Пока модель думает: последние строки рассуждений (блок выше свёрнут) -->
                        <TextBlock Text="{Binding ReasoningTail}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontStyle="Normal" MaxHeight="64" TextTrimming="CharacterEllipsis" Margin="22,-2,0,6"
                                   Visibility="{Binding ReasoningTail, Converter={StaticResource NullToCollapsed}}" />

                        <StackPanel Margin="0,4,0,8" Visibility="{Binding IsPreparing, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding PreparingText}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                            <ProgressBar IsIndeterminate="True" Width="180" Height="4" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Тело -->
                        <r:MarkdownView x:Name="Body" Markdown="{Binding Content}" IsStreaming="{Binding IsStreaming}"
                                        Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Вызовы инструментов -->
                        <ItemsControl ItemsSource="{Binding ToolCalls}" Visibility="{Binding HasToolCalls, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ToolCallView}">
                                    <Border Margin="0,2" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource CodeBackgroundBrush}" Padding="8,4">
                                        <Expander>
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconTool}" Style="{StaticResource IconPath}" TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Header}" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource MonoFontFamily}" FontSize="{DynamicResource CaptionFontSize}" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel>
                                                <TextBlock Text="{l:Loc Tools_Arguments}" Style="{StaticResource CaptionText}" />
                                                <TextBox Text="{Binding Arguments, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{DynamicResource MonoFontFamily}" FontSize="{DynamicResource CaptionFontSize}" />
                                                <TextBlock Text="{l:Loc Tools_Result}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                                                <TextBox x:Name="Res" Text="{Binding Result, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240"
                                                         VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource MonoFontFamily}" FontSize="{DynamicResource CaptionFontSize}" VerticalContentAlignment="Top" />
                                            </StackPanel>
                                        </Expander>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter TargetName="Res" Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Error}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusErrorBrush}"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Действия и статистика: отдельной строкой под сообщением, в общем потоке вёрстки (без отрицательных отступов) -->
                <WrapPanel x:Name="Actions" Grid.Row="1" HorizontalAlignment="Left" Margin="2,2,0,0" Opacity="0.0">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasVariants, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource IconButton}" ToolTip="{l:Loc Chat_PrevVariant}" Command="{Binding DataContext.PrevVariantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Path Data="{StaticResource IconChevronLeft}" Style="{StaticResource IconPath}" />
                        </Button>
                        <TextBlock Text="{Binding VariantText}" Style="{StaticResource StatText}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButton}" ToolTip="{l:Loc Chat_NextVariant}" Command="{Binding DataContext.NextVariantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Path Data="{StaticResource IconChevronRight}" Style="{StaticResource IconPath}" />
                        </Button>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" ToolTip="{l:Loc Chat_Copy}" Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconPath}" />
                    </Button>
                    <Button x:Name="EditBtn" Style="{StaticResource IconButton}" ToolTip="{l:Loc Chat_Edit}" Visibility="Collapsed"
                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <Path Data="{StaticResource IconEdit}" Style="{StaticResource IconPath}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="{l:Loc Chat_Regenerate}" Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <Path Data="{StaticResource IconRetry}" Style="{StaticResource IconPath}" />
                    </Button>
                    <Button x:Name="SpeakBtn" Style="{StaticResource IconButton}" ToolTip="{l:Loc Chat_Speak}" Command="{Binding DataContext.SpeakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <Path Data="{StaticResource IconSpeak}" Style="{StaticResource IconPath}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="{l:Loc Export_Message}" Command="{Binding DataContext.ExportMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <Path Data="{StaticResource IconExport}" Style="{StaticResource IconPath}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="{l:Loc Common_Remove}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <Path Data="{StaticResource IconTrash}" Style="{StaticResource IconPath}" />
                    </Button>
                    <TextBlock Text="{Binding StatsText}" Style="{StaticResource StatText}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"
                               Visibility="{Binding StatsText, Converter={StaticResource NullToCollapsed}}" />
                </WrapPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Bubble" Property="MaxWidth" Value="640" />
                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource UserBubbleBrush}" />
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource UserBubbleBrush}" />
                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource UserBubbleTextBrush}" />
                    <Setter TargetName="Actions" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="EditBtn" Property="Visibility" Value="Visible" />
                    <Setter TargetName="SpeakBtn" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                    <Setter TargetName="Actions" Property="Opacity" Value="0.85" />
                </DataTrigger>
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Модель и статус. Полоса команд: во Fluent невидима, в Aero — как панель команд Проводника -->
        <Border Grid.Row="0" Style="{StaticResource CommandBar}">
        <DockPanel Margin="20,12,12,8">
            <ComboBox DockPanel.Dock="Left" MinWidth="200" MaxWidth="420" ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding SelectedModel}"
                      ToolTip="{l:Loc Chat_ModelPicker}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ModelOption}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconChip}" Style="{StaticResource IconPath}" />
                            <TextBlock Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Group}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="{DynamicResource SmallFontSize}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- Компактный режим: вместо боковой панели — только «Настройки» и «Новый чат» -->
            <Button DockPanel.Dock="Right" Style="{DynamicResource SubtleButtonStyle}" ToolTip="{l:Loc Nav_Settings}"
                    Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Visibility="{Binding IsCompact, Converter={StaticResource BoolToVisibility}}">
                <Path Data="{StaticResource IconSettings}" Style="{StaticResource IconPath}" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{DynamicResource SubtleButtonStyle}" ToolTip="{l:Loc Chat_New}"
                    Command="{Binding DataContext.NewChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Visibility="{Binding IsCompact, Converter={StaticResource BoolToVisibility}}">
                <Path Data="{StaticResource IconPlus}" Style="{StaticResource IconPath}" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{DynamicResource SubtleButtonStyle}" Command="{Binding ToggleInspectorCommand}" ToolTip="{l:Loc Chat_ToggleInspector}"
                    Visibility="{Binding IsCompact, Converter={StaticResource InverseBoolToVisibility}}">
                <Path Data="{StaticResource IconPanel}" Style="{StaticResource IconPath}" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{DynamicResource SubtleButtonStyle}" Command="{Binding PrintCommand}" ToolTip="{l:Loc Export_Print}"
                    Visibility="{Binding IsCompact, Converter={StaticResource InverseBoolToVisibility}}">
                <Path Data="M4,6 V2.5 H12 V6 M4,11.5 H2.5 V6 H13.5 V11.5 H12 M4,9 H12 V14 H4 Z" Style="{StaticResource IconPath}" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{DynamicResource SubtleButtonStyle}" Command="{Binding ExportChatCommand}" ToolTip="{l:Loc Export_Chat}"
                    Visibility="{Binding IsCompact, Converter={StaticResource InverseBoolToVisibility}}">
                <Path Data="{StaticResource IconExport}" Style="{StaticResource IconPath}" />
            </Button>
            <!-- Состояние подключения к эндпоинту выбранной модели: llama-server и сборка либо API-провайдер и отклик.
                 Щелчок — раздел «Движок» или «API-провайдеры». Последний в панели: занимает то, что осталось между
                 списком моделей и кнопками справа, и сокращается многоточием — кнопки не обрезаются на узком окне -->
            <Button Style="{DynamicResource SubtleButtonStyle}" Margin="8,0,8,0" Padding="8,4" MaxWidth="320" HorizontalAlignment="Left"
                    DataContext="{Binding Endpoint}" ToolTip="{Binding Summary}"
                    Command="{Binding DataContext.OpenEndpointCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibility}}">
                <DockPanel>
                    <Ellipse DockPanel.Dock="Left" Style="{StaticResource EndpointStateDot}" />
                    <TextBlock Text="{Binding PillText}" Margin="8,0,0,0" FontSize="{DynamicResource CaptionFontSize}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </DockPanel>
            </Button>
        </DockPanel>
        </Border>

        <!-- Сообщения -->
        <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,4,20,24">
            <ItemsControl ItemsSource="{Binding Messages}" />
        </ScrollViewer>

        <!-- Пустое состояние -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640"
                    Visibility="{Binding HasMessages, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="{l:Loc Chat_EmptyTitle}" Style="{StaticResource TitleText}" HorizontalAlignment="Center" FontSize="{DynamicResource PageTitleFontSize}" />
            <TextBlock Text="{l:Loc Chat_EmptySubtitle}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,18" />
            <WrapPanel HorizontalAlignment="Center">
                <Button Margin="4" Command="{Binding UseSuggestionCommand}" CommandParameter="{l:Loc Chat_Suggest1Prompt}" Content="{l:Loc Chat_Suggest1}" />
                <Button Margin="4" Command="{Binding UseSuggestionCommand}" CommandParameter="{l:Loc Chat_Suggest2Prompt}" Content="{l:Loc Chat_Suggest2}" />
                <Button Margin="4" Command="{Binding UseSuggestionCommand}" CommandParameter="{l:Loc Chat_Suggest3Prompt}" Content="{l:Loc Chat_Suggest3}" />
            </WrapPanel>
        </StackPanel>

        <!-- Поле ввода -->
        <Border Grid.Row="2" Margin="20,4,20,6" Style="{StaticResource Card}" Padding="6">
            <StackPanel>
                <DockPanel Margin="6,2,6,6" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Right" Style="{DynamicResource SubtleButtonStyle}" Content="{l:Loc Common_Cancel}" Command="{Binding CancelEditCommand}" />
                    <TextBlock Text="{l:Loc Chat_Editing}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding PendingAttachments}" Margin="4,0,4,4" Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AttachmentView}">
                            <Border Margin="0,0,6,4" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource ControlFillBrush}">
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Image Source="{Binding Thumbnail}" Height="40" MaxWidth="80" Stretch="Uniform" Cursor="Hand" ToolTip="{l:Loc Preview_Open}"
                                           Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                                        <Image.InputBindings>
                                            <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                                          Command="{Binding DataContext.PreviewAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </Image.InputBindings>
                                    </Image>
                                    <TextBlock Text="{Binding Name}" Margin="6,0" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                                    <Button Style="{StaticResource IconButton}" Width="22" Height="22" Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" Width="12" Height="12" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{DynamicResource SubtleButtonStyle}" VerticalAlignment="Bottom" Command="{Binding AttachCommand}" ToolTip="{l:Loc Chat_Attach}">
                        <Path Data="{StaticResource IconAttach}" Style="{StaticResource IconPath}" />
                    </Button>
                    <Grid Grid.Column="1" Margin="4,0">
                        <TextBox x:Name="InputBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MaxHeight="220" MinHeight="34" VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource ChatFontFamily}" FontSize="{DynamicResource ChatFontSize}" Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" PreviewKeyDown="OnInputPreviewKeyDown" />
                        <TextBlock Text="{Binding InputHint}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False" FontFamily="{DynamicResource ChatFontFamily}" FontSize="{DynamicResource ChatFontSize}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Visibility="{Binding Text, ElementName=InputBox, Converter={StaticResource EmptyToVisible}}" />
                    </Grid>
                    <Grid Grid.Column="2" VerticalAlignment="Bottom">
                        <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding SendCommand}" ToolTip="{l:Loc Chat_Send}" Padding="10,6"
                                Visibility="{Binding IsGenerating, Converter={StaticResource InverseBoolToVisibility}}">
                            <Path Data="{StaticResource IconSend}" Style="{StaticResource IconPath}" />
                        </Button>
                        <Button Command="{Binding StopCommand}" ToolTip="{l:Loc Chat_Stop}" Padding="10,6"
                                Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}">
                            <Path Data="{StaticResource IconStop}" Style="{StaticResource IconPath}" />
                        </Button>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Статус и статистика -->
        <DockPanel Grid.Row="3" Margin="24,0,20,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding ContextText, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding ContextText}" Style="{StaticResource StatText}" VerticalAlignment="Center" />
                <ProgressBar Width="80" Value="{Binding ContextRatio, Mode=OneWay}" Maximum="1" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,12,0"
                       Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding LiveStats}" Style="{StaticResource StatText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
        </DockPanel>

        <!-- Правая панель: параметры беседы -->
        <Border x:Name="Inspector" Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Width="300" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0"
                Visibility="{Binding ShowInspector, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12,16,16">
                <StackPanel>
                    <!-- Заголовок и «Настроить панель»: какие блоки показывать, выбирает пользователь (Layout) -->
                    <DockPanel>
                        <Button x:Name="CustomizeButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OnCustomizeInspector"
                                ToolTip="{l:Loc Inspector_Customize}">
                            <Path Data="{StaticResource IconSettings}" Style="{StaticResource IconPath}" />
                        </Button>
                        <TextBlock Text="{l:Loc Inspector_Title}" Style="{StaticResource SubtitleText}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Popup x:Name="CustomizePopup" PlacementTarget="{Binding ElementName=CustomizeButton}" Placement="Bottom" HorizontalOffset="-236"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Padding="16,12" Margin="0,4,0,0" Width="264"
                                TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                            <StackPanel DataContext="{Binding Layout}">
                                <TextBlock Text="{l:Loc Inspector_Customize}" Style="{StaticResource SubtitleText}" />
                                <TextBlock Text="{l:Loc Inspector_CustomizeHint}" Style="{StaticResource CaptionText}" Margin="0,4,0,8" />
                                <ItemsControl ItemsSource="{Binding ChatItems}" ItemTemplate="{StaticResource InspectorToggleTemplate}" Focusable="False" />
                                <TextBlock Text="{l:Loc Res_Title}" Style="{StaticResource SectionHeaderText}" Margin="0,8,0,4" />
                                <ItemsControl ItemsSource="{Binding ServerItems}" ItemTemplate="{StaticResource InspectorToggleTemplate}" Focusable="False" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="{l:Loc Inspector_Reset}" Command="{Binding ResetCommand}" Margin="0,0,8,4" />
                                    <Button Style="{DynamicResource SubtleButtonStyle}" Content="{l:Loc Inspector_ShowAll}" Command="{Binding ShowAllCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <TextBlock Text="{l:Loc Inspector_EmptyHint}" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                               Visibility="{Binding Layout.IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Visibility="{Binding Layout.ShowPrompt, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{l:Loc Chat_SystemPrompt}" Style="{StaticResource SectionHeaderText}" />
                        <ComboBox ItemsSource="{Binding PromptPresets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Margin="0,0,0,6"
                                  ToolTip="{l:Loc Prompts_Apply}" />
                        <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="200"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding Layout.ShowReasoning, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{l:Loc Chat_ThinkingMode}" Style="{StaticResource SectionHeaderText}" />
                        <ComboBox ItemsSource="{Binding ThinkingOptions}" SelectedItem="{Binding Thinking}" DisplayMemberPath="Title" />
                        <TextBlock Text="{l:Loc Chat_ReasoningStyle}" Style="{StaticResource CaptionText}" Margin="0,8,0,4" />
                        <ComboBox ItemsSource="{Binding ReasoningStyles}" SelectedItem="{Binding ReasoningStyle}" DisplayMemberPath="Title"
                                  ToolTip="{l:Loc Chat_ReasoningStyleHint}" />
                        <TextBlock Text="{Binding ReasoningHint}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                   Visibility="{Binding ReasoningHint, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding Layout.ShowParameters, Converter={StaticResource BoolToVisibility}}">
                        <!-- Инструменты чата: набор, галочки и цена описаний в токенах (они уходят в каждом запросе) -->
                        <StackPanel DataContext="{Binding ToolSet}">
                            <TextBlock Text="{l:Loc Tools_ChatSet}" Style="{StaticResource SectionHeaderText}" />
                            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" DisplayMemberPath="Title" ToolTip="{l:Loc Tools_ChatSetHint}" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource StatText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <Expander Margin="0,4,0,0" Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                                <Expander.Header>
                                    <TextBlock Text="{l:Loc Tools_ChatList}" Style="{StaticResource BodyText}" />
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ChatToolItem}">
                                            <DockPanel Margin="0,2" ToolTip="{Binding Hint}">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TokensText}" Style="{StaticResource StatText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <CheckBox IsChecked="{Binding IsOn}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="{DynamicResource CaptionFontSize}" TextTrimming="CharacterEllipsis" />
                                                </CheckBox>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                        <CheckBox Content="{l:Loc Chat_OverrideTemperature}" IsChecked="{Binding OverrideTemperature}" Margin="0,12,0,4" />
                        <DockPanel IsEnabled="{Binding OverrideTemperature}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Temperature, StringFormat='{}{0:0.00}'}" Width="36" TextAlignment="Right" VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="2" Value="{Binding Temperature}" SmallChange="0.05" LargeChange="0.1" />
                        </DockPanel>
                        <TextBlock Text="{l:Loc Chat_InspectorHint}" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- Статистика беседы: подключение к эндпоинту (локальный сервер или API) и токены -->
                    <views:ServerInsightView Source="{Binding StatGroups}" Margin="0,16,0,0" />

                    <!-- llama-server: диагностика, сборка, нагрузка, скорость, запуск, модель — только выбранные группы -->
                    <StackPanel Visibility="{Binding Layout.ShowServerHeader, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel Margin="0,4,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding Server.CopyAllCommand}" ToolTip="{l:Loc Ins_Copy}">
                                <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconPath}" />
                            </Button>
                            <Ellipse DataContext="{Binding Server}" Style="{StaticResource ServerStateDot}" />
                            <TextBlock Text="{l:Loc Res_Title}" Style="{StaticResource SubtitleText}" FontSize="{DynamicResource AppFontSize}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <views:ServerInsightView Source="{Binding Server.InspectorGroups}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
