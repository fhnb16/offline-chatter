<UserControl x:Class="OfflineChatter.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OfflineChatter.Views"
             xmlns:l="clr-namespace:OfflineChatter.Localization">
    <UserControl.Resources>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,32,40,32" MaxWidth="760" HorizontalAlignment="Center">
            <TextBlock Text="{l:Loc Welcome_Title}" Style="{StaticResource PageTitleText}" FontSize="28" />
            <TextBlock Text="{l:Loc Welcome_Subtitle}" Style="{StaticResource CaptionText}" FontSize="{DynamicResource AppFontSize}" Margin="0,-8,0,20" />

            <!-- 1. Железо -->
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" Foreground="{DynamicResource TextOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                    <StackPanel>
                        <TextBlock Text="{l:Loc Welcome_Step_Hardware}" Style="{StaticResource SubtitleText}" />
                        <TextBlock Text="{Binding HardwareText}" Style="{StaticResource BodyText}" Margin="0,4,0,0" LineHeight="20" />
                        <TextBlock Text="{Binding CompatWarning}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusWarnBrush}"
                                   Visibility="{Binding CompatWarning, Converter={StaticResource NullToCollapsed}}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. Движок -->
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" Foreground="{DynamicResource TextOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                    <StackPanel>
                        <TextBlock Text="{l:Loc Welcome_Step_Engine}" Style="{StaticResource SubtitleText}" />
                        <TextBlock Text="{Binding EngineText}" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                        <CheckBox Content="{Binding GpuOptionText}" IsChecked="{Binding UseRecommendedGpu}" Margin="0,8,0,0"
                                  Visibility="{Binding HasGpuOption, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{DynamicResource SubtleButtonStyle}" Content="{l:Loc Welcome_OwnEngine}" Command="{Binding UseOwnEngineCommand}" HorizontalAlignment="Left" Margin="-8,6,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 3. Модель -->
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" Foreground="{DynamicResource TextOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                    <StackPanel>
                        <TextBlock Text="{l:Loc Welcome_Step_Model}" Style="{StaticResource SubtitleText}" />
                        <TextBlock Text="{Binding ModelText}" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="-8,6,0,0">
                            <Button Style="{DynamicResource SubtleButtonStyle}" Content="{l:Loc Welcome_OwnModel}" Command="{Binding UseOwnModelCommand}" />
                            <Button Style="{DynamicResource SubtleButtonStyle}" Content="{l:Loc Welcome_UseApi}" Command="{Binding UseApiCommand}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 4. Правая панель чата -->
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <Border Style="{StaticResource StepNumber}"><TextBlock Text="4" Foreground="{DynamicResource TextOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                    <StackPanel>
                        <TextBlock Text="{l:Loc Welcome_Step_Inspector}" Style="{StaticResource SubtitleText}" />
                        <TextBlock Text="{l:Loc Welcome_InspectorText}" Style="{StaticResource BodyText}" Margin="0,4,0,8" />
                        <views:InspectorLayoutView DataContext="{Binding InspectorLayout}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding InstallAllCommand}" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDownload}" Style="{StaticResource IconPath}" />
                        <TextBlock Text="{l:Loc Welcome_InstallAll}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="{l:Loc Welcome_Finish}" Command="{Binding FinishCommand}" Margin="8,0,0,0" Padding="16,8" />
            </StackPanel>
            <ProgressBar IsIndeterminate="True" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />

            <views:DownloadsView DataContext="{Binding Downloads}" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
