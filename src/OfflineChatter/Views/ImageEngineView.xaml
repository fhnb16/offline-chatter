<UserControl x:Class="OfflineChatter.Views.ImageEngineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OfflineChatter.ViewModels"
             xmlns:l="clr-namespace:OfflineChatter.Localization"
             xmlns:c="clr-namespace:OfflineChatter.Controls">
    <!-- DataContext: ImageEngineViewModel -->
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Visibility" Value="{DynamicResource UiHintVisibility}" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <DataTemplate x:Key="EnumItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- ===== Как это работает (только «Пошагово») ===== -->
        <Border Style="{StaticResource NoticeCard}" Visibility="{DynamicResource UiGuideVisibility}">
            <StackPanel>
                <TextBlock Text="{l:Loc ImgEngine_GuideTitle}" Style="{StaticResource SubtitleText}" />
                <TextBlock Text="{l:Loc ImgEngine_Guide}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18" />
            </StackPanel>
        </Border>

        <!-- ===== Генератор ===== -->
        <Border Style="{StaticResource SettingCard}">
            <StackPanel>
                <c:AdaptiveRow Breakpoint="560">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource ServerStateDot}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource SubtitleText}" TextTrimming="CharacterEllipsis">
                                <Run Text="{l:Loc Img_Generator}" /><Run Text=" · " Foreground="{DynamicResource TextTertiaryBrush}" /><Run Text="{Binding ServerStateText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding ModelTitle}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Command="{Binding StartServerCommand}" Margin="0,0,6,4" ToolTip="{l:Loc ImgEngine_StartHint}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlay}" Style="{StaticResource IconPath}" />
                                <TextBlock Text="{l:Loc ImgEngine_Start}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StopServerCommand}" Content="{l:Loc Engine_Stop}" Margin="0,0,0,4" />
                    </WrapPanel>
                </c:AdaptiveRow>
                <TextBlock Text="{Binding ServerError}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusErrorBrush}" TextWrapping="Wrap"
                           Margin="0,8,0,0" Visibility="{Binding ServerError, Converter={StaticResource NullToCollapsed}}" />
                <Expander Header="{l:Loc Engine_ServerLog}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBox Text="{Binding ServerCommandLine, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 FontFamily="{DynamicResource MonoFontFamily}" FontSize="{DynamicResource CaptionFontSize}" Margin="0,0,0,6"
                                 Visibility="{Binding ServerCommandLine, Converter={StaticResource NullToCollapsed}}" />
                        <Border Style="{StaticResource Card}" Padding="2">
                            <ListBox ItemsSource="{Binding ServerLines}" Height="220" c:AutoScroll.ToEnd="True"
                                     FontFamily="{DynamicResource MonoFontFamily}" FontSize="{DynamicResource SmallFontSize}" BorderThickness="0" Background="Transparent"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="4,0" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                        <Button HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding CopyLogCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconPath}" />
                                <TextBlock Text="{l:Loc Logs_Copy}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <!-- ===== Сборки ===== -->
        <c:AdaptiveRow Margin="0,16,0,8" Breakpoint="560">
            <TextBlock Text="{l:Loc ImgEngine_Builds}" Style="{StaticResource SubtitleText}" />
            <Button Command="{Binding AddExternalCommand}" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                    <TextBlock Text="{l:Loc Engine_AddExternal}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </c:AdaptiveRow>
        <TextBlock Text="{l:Loc ImgEngine_NoneInstalled}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                   Visibility="{Binding HasInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding Installed}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SdEngineItem}">
                    <Border Style="{StaticResource SettingCard}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{l:Loc Engine_MakeActive}" Margin="0,0,6,0"
                                        Command="{Binding DataContext.SetActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibility}}" />
                                <Button Style="{DynamicResource SubtleButtonStyle}" ToolTip="{l:Loc Settings_OpenData}"
                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                                </Button>
                                <Button Style="{DynamicResource SubtleButtonStyle}" ToolTip="{l:Loc Common_Remove}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <Path Data="{StaticResource IconTrash}" Style="{StaticResource IconPath}" />
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0" Padding="7,1"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{l:Loc Engine_Active}" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource AccentTextBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding Kind}" Style="{StaticResource CaptionText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <TextBlock x:Name="Health" Text="{Binding Health}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusOkBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding HealthOk}" Value="False">
                            <Setter TargetName="Health" Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Установка ===== -->
        <Border Style="{StaticResource SettingCard}">
            <StackPanel>
                <TextBlock Text="{l:Loc ImgEngine_Download}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                <TextBlock Text="{l:Loc ImgEngine_DownloadHint}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding RecommendedText}" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                           Visibility="{Binding RecommendedText, Converter={StaticResource NullToCollapsed}}" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding InstallRecommendedCommand}" Margin="0,0,8,4">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDownload}" Style="{StaticResource IconPath}" />
                            <TextBlock Text="{l:Loc ImgEngine_InstallRecommended}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelInstallCommand}" Content="{l:Loc Common_Cancel}" Margin="0,0,8,4"
                            Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding InstallStatus}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="4,0,0,4" />
                </WrapPanel>
                <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsLoadingReleases, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding ReleasesError}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusErrorBrush}"
                           Visibility="{Binding ReleasesError, Converter={StaticResource NullToCollapsed}}" Margin="0,8,0,0" TextWrapping="Wrap" />

                <Expander Header="{l:Loc ImgEngine_PickManually}" Margin="0,8,0,0" Visibility="{DynamicResource UiAdvancedVisibility}"
                          IsExpanded="{DynamicResource UiAdvancedExpanded}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Tag, Mode=OneWay}" />
                                            <Run Text="{Binding PublishedAt, Mode=OneWay, StringFormat=' · {0:d}'}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}" DisplayMemberPath="Title" />
                            <Button Grid.Column="3" Style="{DynamicResource SubtleButtonStyle}" Margin="6,0,0,0" ToolTip="{l:Loc Common_Refresh}"
                                    Command="{Binding RefreshReleasesCommand}">
                                <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPath}" />
                            </Button>
                        </Grid>
                        <CheckBox Content="{l:Loc Engine_ShowAll}" IsChecked="{Binding ShowAllVariants}" Margin="0,8,0,0" />
                        <Button Command="{Binding InstallCommand}" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Style="{StaticResource IconPath}" />
                                <TextBlock Text="{l:Loc Engine_InstallButton}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <!-- ===== Параметры запуска ===== -->
        <TextBlock Text="{l:Loc ImgEngine_Launch}" Style="{StaticResource SubtitleText}" Margin="0,16,0,8" />
        <Border Style="{StaticResource SettingCard}">
            <StackPanel>
                <!-- Модель и пресет семейства -->
                <c:AdaptiveRow ControlMinWidth="240">
                    <StackPanel>
                        <TextBlock Text="{l:Loc ImgEngine_Family}" Style="{StaticResource BodyText}" />
                        <TextBlock Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis">
                            <Run Text="{l:Loc Img_Model}" /><Run Text=": " /><Run Text="{Binding ModelTitle, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Families}" SelectedItem="{Binding Family}" ItemTemplate="{StaticResource EnumItemTemplate}" />
                </c:AdaptiveRow>
                <TextBlock Text="{Binding FamilyHint}" Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                           Visibility="{Binding FamilyHint, Converter={StaticResource NullToCollapsed}}" />
                <Border Style="{StaticResource Panel}" Margin="0,8,0,0" Visibility="{Binding Model, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc ImgEngine_PresetValues}" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding PresetFacts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PresetFact}">
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource StatText}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Память и скорость -->
                <TextBlock Text="{l:Loc ImgEngine_TriStateHint}" Style="{StaticResource FieldHint}" Margin="0,12,0,0" TextWrapping="Wrap" />
                <c:ResponsiveGrid MinColumnWidth="300" MaxColumns="2" Margin="0,8,0,0">
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="{l:Loc ImgEngine_Memory}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                            <TextBlock Text="{l:Loc ImgEngine_MemoryHint}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                            <CheckBox IsThreeState="True" IsChecked="{Binding OffloadToCpu}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{l:Loc ImgEngine_OffloadToCpu}" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="{l:Loc ImgEngine_OffloadToCpuHint}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsThreeState="True" IsChecked="{Binding ClipOnCpu}" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="{l:Loc ImgEngine_ClipOnCpu}" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="{l:Loc ImgEngine_ClipOnCpuHint}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsThreeState="True" IsChecked="{Binding VaeOnCpu}" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="{l:Loc ImgEngine_VaeOnCpu}" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="{l:Loc ImgEngine_VaeOnCpuHint}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsThreeState="True" IsChecked="{Binding VaeTiling}" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="{l:Loc ImgEngine_VaeTiling}" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="{l:Loc ImgEngine_VaeTilingHint}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding ShareVram}" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="{l:Loc ImgEngine_ShareVram}" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="{l:Loc ImgEngine_ShareVramHint}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="{l:Loc ImgEngine_Speed}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                            <TextBlock Text="{l:Loc ImgEngine_FlashAttn}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding FlashAttentionOptions}" SelectedItem="{Binding FlashAttention}" />
                            <TextBlock Text="{l:Loc ImgEngine_FlashAttnHint}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                            <TextBlock Text="{l:Loc ImgEngine_Threads}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Threads, UpdateSourceTrigger=PropertyChanged, Delay=500}" FontFamily="{DynamicResource MonoFontFamily}" />
                            <TextBlock Text="{l:Loc ImgEngine_ThreadsHint}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                            <StackPanel Visibility="{DynamicResource UiAdvancedVisibility}">
                                <TextBlock Text="{l:Loc ImgEngine_WeightType}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding WeightTypes}" SelectedItem="{Binding WeightType}" />
                                <TextBlock Text="{l:Loc ImgEngine_WeightTypeHint}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </c:ResponsiveGrid>

                <!-- Дополнительно -->
                <Expander Header="{l:Loc ImgEngine_Advanced}" Margin="0,12,0,0" IsExpanded="{DynamicResource UiAdvancedExpanded}"
                          Visibility="{DynamicResource UiAdvancedVisibility}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding ServerDefaults}" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="{l:Loc ImgEngine_ServerDefaults}" Style="{StaticResource BodyText}" />
                                <TextBlock Text="{l:Loc ImgEngine_ServerDefaultsHint}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="{l:Loc ImgEngine_Rng}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding RngOptions}" SelectedItem="{Binding Rng}" />
                        <TextBlock Text="{l:Loc ImgEngine_RngHint}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                        <TextBlock Text="{l:Loc ImgEngine_LoraDir}" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:Loc Common_Browse}" Margin="6,0,0,0" Command="{Binding PickLoraDirCommand}" />
                            <TextBox Text="{Binding LoraDir, UpdateSourceTrigger=PropertyChanged, Delay=800}" />
                        </DockPanel>
                        <TextBlock Text="{l:Loc ImgEngine_ModelArgs}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ModelArgs, UpdateSourceTrigger=PropertyChanged, Delay=800}" FontFamily="{DynamicResource MonoFontFamily}" />
                        <TextBlock Text="{l:Loc ImgEngine_ModelArgsHint}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                        <TextBlock Text="{l:Loc Profiles_Extra}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ExtraArgs, UpdateSourceTrigger=PropertyChanged, Delay=800}" FontFamily="{DynamicResource MonoFontFamily}" />
                    </StackPanel>
                </Expander>

                <!-- Командная строка -->
                <Expander Header="{l:Loc ImgEngine_CommandLine}" Margin="0,8,0,0" IsExpanded="{DynamicResource UiAdvancedExpanded}">
                    <StackPanel>
                        <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{DynamicResource MonoFontFamily}"
                                 FontSize="{DynamicResource CaptionFontSize}" />
                        <TextBlock Text="{Binding SkippedText}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusWarnBrush}"
                                   Visibility="{Binding SkippedText, Converter={StaticResource NullToCollapsed}}" />
                        <Button Command="{Binding CopyPreviewCommand}" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconPath}" />
                                <TextBlock Text="{l:Loc ImgEngine_CopyCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Expander>
                <WrapPanel Margin="0,12,0,0">
                    <Button Command="{Binding StartServerCommand}" Content="{l:Loc ImgEngine_Restart}" Margin="0,0,8,4" />
                    <Button Command="{Binding ResetLaunchCommand}" Content="{l:Loc ImgEngine_ResetLaunch}" Margin="0,0,8,4" ToolTip="{l:Loc ImgEngine_ResetLaunchHint}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ===== Публичный API изображений ===== -->
        <TextBlock Text="{l:Loc ImgApi_Title}" Style="{StaticResource SubtitleText}" Margin="0,16,0,8" />
        <Border Style="{StaticResource SettingCard}">
            <StackPanel>
                <CheckBox IsChecked="{Binding ExposeApi}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc ImgApi_Expose}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{l:Loc ImgApi_ExposeHint}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                    </StackPanel>
                </CheckBox>
                <StackPanel Visibility="{Binding ExposeApi, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                    <c:AdaptiveRow ControlMinWidth="240" Margin="0,4,0,0">
                        <TextBlock Text="{l:Loc Api_Port}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged, Delay=800}" FontFamily="{DynamicResource MonoFontFamily}" />
                    </c:AdaptiveRow>
                    <c:AdaptiveRow ControlMinWidth="240" Margin="0,8,0,0">
                        <TextBlock Text="{l:Loc Api_Listen}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding ListenOptions}" SelectedItem="{Binding Listen}" DisplayMemberPath="Title" />
                    </c:AdaptiveRow>
                    <TextBlock Text="{l:Loc Api_LanHint}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusWarnBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding IsLanExposed, Converter={StaticResource BoolToVisibility}}" />
                    <c:AdaptiveRow ControlMinWidth="240" Margin="0,8,0,0">
                        <TextBlock Text="{l:Loc Api_Key}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <Grid>
                            <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged, Delay=600}" FontFamily="{DynamicResource MonoFontFamily}"
                                     Visibility="{Binding IsKeyVisible, Converter={StaticResource BoolToVisibility}}" />
                            <Border Style="{StaticResource Card}" Padding="8,6" MinHeight="32"
                                    Visibility="{Binding IsKeyVisible, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="{Binding DisplayKey}" FontFamily="{DynamicResource MonoFontFamily}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Grid>
                    </c:AdaptiveRow>
                    <WrapPanel Margin="0,8,0,0">
                        <ToggleButton IsChecked="{Binding IsKeyVisible}" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconEye}" Style="{StaticResource IconPath}" />
                                <TextBlock Text="{l:Loc Api_Show}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <Button Command="{Binding CopyKeyCommand}" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconPath}" />
                                <TextBlock Text="{l:Loc Api_Copy}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RegenerateKeyCommand}" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconKey}" Style="{StaticResource IconPath}" />
                                <TextBlock Text="{l:Loc Api_Regenerate}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="{Binding ApiStatus}" Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CopyUrlCommand}" ToolTip="{l:Loc Api_Copy}">
                            <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconPath}" />
                        </Button>
                        <TextBlock Style="{StaticResource StatText}" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center">
                            <Run Text="{Binding LocalUrl, Mode=OneWay}" /><Run Text="{Binding LanUrl, Mode=OneWay, StringFormat=' · {0}'}" />
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Text="{l:Loc ImgApi_Endpoints}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{l:Loc ImgApi_ExampleTitle}" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CopyExampleCommand}" ToolTip="{l:Loc Api_Copy}" VerticalAlignment="Top">
                            <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconPath}" />
                        </Button>
                        <TextBox Text="{Binding Example, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{DynamicResource MonoFontFamily}" FontSize="{DynamicResource CaptionFontSize}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CopyEditExampleCommand}" ToolTip="{l:Loc Api_Copy}" VerticalAlignment="Top">
                            <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconPath}" />
                        </Button>
                        <TextBox Text="{Binding EditExample, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{DynamicResource MonoFontFamily}" FontSize="{DynamicResource CaptionFontSize}" />
                    </DockPanel>
                </StackPanel>
                <WrapPanel Margin="0,12,0,0">
                    <Button Command="{Binding ApplyApiCommand}" Content="{l:Loc ImgApi_Apply}" Margin="0,0,8,4" />
                </WrapPanel>
                <TextBlock Text="{Binding ApiMessage}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding ApiMessage, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
