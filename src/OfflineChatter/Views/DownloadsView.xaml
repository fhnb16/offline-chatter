<UserControl x:Class="OfflineChatter.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OfflineChatter.ViewModels"
             xmlns:l="clr-namespace:OfflineChatter.Localization">
    <!-- Список загрузок. DataContext: DownloadsViewModel -->
    <StackPanel Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
        <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Style="{DynamicResource SubtleButtonStyle}" Command="{Binding ClearFinishedCommand}"
                    Content="{l:Loc Download_ClearFinished}" />
            <TextBlock Text="{l:Loc Download_Title}" Style="{StaticResource SubtitleText}" VerticalAlignment="Center" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DownloadItemViewModel}">
                    <Border Style="{StaticResource SettingCard}" Padding="12,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Button Style="{DynamicResource SubtleButtonStyle}" Command="{Binding PauseCommand}" ToolTip="{l:Loc Download_Pause}"
                                        Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}">
                                    <Path Data="M5,3 V13 M11,3 V13" Style="{StaticResource IconPath}" />
                                </Button>
                                <Button Style="{DynamicResource SubtleButtonStyle}" Command="{Binding ResumeCommand}" ToolTip="{l:Loc Download_Resume}"
                                        Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}">
                                    <Path Data="{StaticResource IconPlay}" Style="{StaticResource IconPath}" />
                                </Button>
                                <Button Style="{DynamicResource SubtleButtonStyle}" Command="{Binding CancelCommand}" ToolTip="{l:Loc Common_Cancel}"
                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}">
                                    <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" />
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Margin="0,6,0,4"
                                             IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
