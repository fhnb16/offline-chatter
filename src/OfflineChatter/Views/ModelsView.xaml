<UserControl x:Class="OfflineChatter.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OfflineChatter.ViewModels"
             xmlns:views="clr-namespace:OfflineChatter.Views"
             xmlns:models="clr-namespace:OfflineChatter.Core.Models;assembly=OfflineChatter.Core"
             xmlns:l="clr-namespace:OfflineChatter.Localization"
             xmlns:r="clr-namespace:OfflineChatter.Rendering"
             xmlns:c="clr-namespace:OfflineChatter.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="EnumItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,32">
            <c:AdaptiveRow Breakpoint="560">
                <TextBlock Text="{l:Loc Nav_Models}" Style="{StaticResource PageTitleText}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="{l:Loc Ui_DetailShort}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Main.DetailLevels}" SelectedItem="{Binding Main.Detail}" MinWidth="140"
                              ItemTemplate="{StaticResource EnumItemTemplate}" ToolTip="{l:Loc Ui_DetailHint}" />
                </StackPanel>
            </c:AdaptiveRow>
            <TextBlock Text="{l:Loc Models_PageIntro}" Style="{StaticResource CaptionText}" Margin="0,-8,0,12" TextWrapping="Wrap" Visibility="{DynamicResource UiHintVisibility}" />

            <!-- Загрузки — наверху: раньше список был в самом низу страницы, и прогресса не было видно -->
            <views:DownloadsView DataContext="{Binding Downloads}" Margin="0,0,0,16" />

            <!-- ===== Мои модели ===== -->
            <c:AdaptiveRow Margin="0,0,0,8" Breakpoint="640">
                <TextBlock Text="{l:Loc Models_Mine}" Style="{StaticResource SubtitleText}" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button Command="{Binding AddLocalCommand}" Margin="0,0,6,4">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Style="{StaticResource IconPath}" />
                            <TextBlock Text="{l:Loc Models_AddFile}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ScanCommand}" Margin="0,0,6,4">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSearch}" Style="{StaticResource IconPath}" />
                            <TextBlock Text="{l:Loc Models_Scan}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddScanFolderCommand}" Margin="0,0,0,4" ToolTip="{l:Loc Models_PickScanFolder}">
                        <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                    </Button>
                </WrapPanel>
            </c:AdaptiveRow>
            <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource CaptionText}" Margin="0,0,0,6"
                       Visibility="{Binding ScanStatus, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock Text="{l:Loc Models_NoneYet}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                       Visibility="{Binding HasLocalModels, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding LocalModels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LocalModelItem}">
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{l:Loc Models_Use}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.UseModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            IsEnabled="{Binding Exists}" />
                                    <Button Style="{DynamicResource SubtleButtonStyle}" ToolTip="{l:Loc Settings_OpenData}"
                                            Command="{Binding DataContext.OpenModelFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                                    </Button>
                                    <Button Style="{DynamicResource SubtleButtonStyle}" ToolTip="{l:Loc Common_Remove}"
                                            Command="{Binding DataContext.RemoveModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconTrash}" Style="{StaticResource IconPath}" />
                                    </Button>
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0" Padding="7,1"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{l:Loc Engine_Active}" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource AccentTextBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource StatusPill}" Margin="6,0,0,0" Padding="7,1"
                                                Visibility="{Binding HasVision, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconImage}" Style="{StaticResource IconPath}" Width="14" Height="14"
                                                      TextElement.Foreground="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.1" />
                                                <TextBlock Text="{l:Loc Models_Vision}" FontSize="{DynamicResource SmallFontSize}" Margin="4,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{l:Loc Models_Missing}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusErrorBrush}"
                                               Visibility="{Binding Exists, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Модели изображений ===== -->
            <c:AdaptiveRow Margin="0,20,0,8" Breakpoint="640">
                <TextBlock Text="{l:Loc Models_ImageMine}" Style="{StaticResource SubtitleText}" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button Command="{Binding AddImageFilesCommand}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Style="{StaticResource IconPath}" />
                            <TextBlock Text="{l:Loc Models_AddImageFiles}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </c:AdaptiveRow>
            <TextBlock Text="{l:Loc Models_ImageMineHint}" Style="{StaticResource CaptionText}" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="{DynamicResource UiHintVisibility}" />
            <TextBlock Text="{l:Loc Models_ImageNoneYet}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                       Visibility="{Binding HasImageModels, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding ImageModels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ImageModelItem}">
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="{l:Loc Models_Use}" Margin="0,0,6,0" IsEnabled="{Binding IsReady}"
                                                Command="{Binding DataContext.UseImageModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{DynamicResource SubtleButtonStyle}" ToolTip="{l:Loc Common_Remove}"
                                                Command="{Binding DataContext.RemoveImageModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconTrash}" Style="{StaticResource IconPath}" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0" Padding="7,1" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{l:Loc Engine_Active}" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource AccentTextBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource StatusPill}" Margin="6,0,0,0" Padding="7,1" Visibility="{Binding SupportsEdit, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{l:Loc Models_ImageEdit}" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MissingText}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusWarnBrush}" TextWrapping="Wrap"
                                                   Visibility="{Binding MissingText, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                </DockPanel>
                                <Expander Header="{l:Loc Models_ImageFiles}" Margin="0,6,0,0">
                                    <StackPanel Margin="0,4,0,0">
                                        <c:AdaptiveRow ControlMinWidth="220">
                                            <TextBlock Text="{l:Loc ImgEngine_Family}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding Families}" SelectedItem="{Binding Family}" ItemTemplate="{StaticResource EnumItemTemplate}" />
                                        </c:AdaptiveRow>
                                        <ItemsControl ItemsSource="{Binding Components}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ImageComponentRow}">
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                                   ToolTip="{Binding Hint}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock x:Name="P" Grid.Column="1" Text="{Binding PathText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                            <Button Style="{StaticResource IconButton}" ToolTip="{l:Loc Common_Browse}"
                                                                    Command="{Binding DataContext.PickComponentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}" ToolTip="{l:Loc Common_Remove}"
                                                                    Command="{Binding DataContext.ClearComponentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsRequired}" Value="True" />
                                                                <Condition Binding="{Binding Exists}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="P" Property="Foreground" Value="{DynamicResource StatusWarnBrush}" />
                                                        </MultiDataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{l:Loc Models_ImageFilesHint}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" Visibility="{DynamicResource UiHintVisibility}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Готовые наборы: модель и все кодировщики одной кнопкой -->
            <TextBlock Text="{l:Loc Models_Kits}" Style="{StaticResource SubtitleText}" Margin="0,16,0,4" />
            <TextBlock Text="{l:Loc Models_KitsHint}" Style="{StaticResource CaptionText}" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="{DynamicResource UiHintVisibility}" />
            <ItemsControl ItemsSource="{Binding Kits}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <c:ResponsiveGrid MinColumnWidth="300" MaxColumns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ImageKitItem}">
                        <Border Style="{StaticResource Card}" Padding="12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <WrapPanel>
                                        <Button x:Name="Get" Command="{Binding DataContext.DownloadKitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Margin="0,0,8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconDownload}" Style="{StaticResource IconPath}" />
                                                <TextBlock Text="{l:Loc Models_KitDownload}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Content="{l:Loc Common_Cancel}" Margin="0,0,8,4" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.CancelKitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <TextBlock Text="{l:Loc Models_KitInstalled}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusOkBrush}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                    </WrapPanel>
                                    <StackPanel Visibility="{Binding Progress, Converter={StaticResource NullToCollapsed}}" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Progress.Text}" Style="{StaticResource StatText}" TextWrapping="Wrap"
                                                   FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <ProgressBar Style="{DynamicResource ProgressBarStyle}" Maximum="100" Value="{Binding Progress.Percent, Mode=OneWay}" Margin="0,4,0,0"
                                                     IsIndeterminate="{Binding Progress.Indeterminate, Mode=OneWay, FallbackValue=False}"
                                                     Visibility="{Binding Progress.Active, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                                                     AutomationProperties.Name="{Binding Progress.Text}" />
                                        <TextBlock Text="{Binding Progress.Error}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusErrorBrush}" TextWrapping="Wrap"
                                                   Visibility="{Binding Progress.Error, Converter={StaticResource NullToCollapsed}, FallbackValue=Collapsed}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0" Padding="6,0" Visibility="{Binding Recommended, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{l:Loc Engine_Recommended}" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource AccentTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Style="{StaticResource StatText}" Margin="0,6,0,0" TextWrapping="Wrap">
                                        <Run Text="{Binding Size, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Files, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock x:Name="Fit" Text="{Binding FitText}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusOkBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Fits}" Value="False">
                                <Setter TargetName="Fit" Property="Foreground" Value="{DynamicResource StatusWarnBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Recommended}" Value="True">
                                <Setter TargetName="Get" Property="Style" Value="{DynamicResource AccentButtonStyle}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                <Setter TargetName="Get" Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Hugging Face ===== -->
            <TextBlock Text="{l:Loc Models_HfTitle}" Style="{StaticResource SubtitleText}" Margin="0,20,0,8" />
            <Border Style="{StaticResource SettingCard}">
                <c:AdaptiveRow>
                    <StackPanel>
                        <TextBlock Text="{l:Loc Models_DefaultTitle}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DefaultRepo}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <Button Command="{Binding ShowDefaultCommand}" Content="{l:Loc Models_ShowDefault}" HorizontalAlignment="Right" />
                </c:AdaptiveRow>
            </Border>

            <Grid Margin="0,4,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Query" Style="{DynamicResource SearchBox}" Tag="{l:Loc Models_SearchHint}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <ComboBox Grid.Column="1" MinWidth="150" Margin="8,0,0,0" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}"
                          ItemTemplate="{StaticResource EnumItemTemplate}" />
                <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding SearchCommand}" Content="{l:Loc Models_Search}" />
            </Grid>
            <WrapPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                    <TextBlock Text="{l:Loc Models_Task}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SearchTask}" MinWidth="200" ItemTemplate="{StaticResource EnumItemTemplate}" />
                </StackPanel>
                <CheckBox Content="{l:Loc Models_GgufOnly}" IsChecked="{Binding GgufOnly}" Margin="0,4,20,4" VerticalAlignment="Center" ToolTip="{l:Loc Models_GgufOnlyHint}" />
                <CheckBox Content="{l:Loc Models_FitsOnly}" IsChecked="{Binding FitsOnly}" Margin="0,4,20,4" VerticalAlignment="Center" />
            </WrapPanel>
            <TextBlock Text="{Binding TaskHint}" Style="{StaticResource CaptionText}" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="{DynamicResource UiHintVisibility}" />
            <Border Style="{StaticResource NoticeCard}" Visibility="{Binding IsUnsupportedTask, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{l:Loc Models_TaskUnsupported}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Margin="0,0,0,8" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{l:Loc Models_Searching}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" TextWrapping="Wrap" />
                <ProgressBar Style="{DynamicResource ProgressBarStyle}" IsIndeterminate="True" AutomationProperties.Name="{l:Loc Models_Searching}" />
            </StackPanel>
            <TextBlock Text="{Binding SearchError}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusErrorBrush}"
                       Visibility="{Binding SearchError, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,8" />

            <!-- Список и детали: рядом на широком окне, друг под другом на узком.
                 Список прижат к верху: раньше он центрировался в растянутой ячейке, и при раскрытии README появлялись поля сверху и снизу. -->
            <c:ResponsiveGrid MinColumnWidth="340" MaxColumns="2">
                <!-- Результаты -->
                <Border Style="{StaticResource Card}" Padding="4" VerticalAlignment="Top">
                    <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" Height="460"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:HfModelSummary}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                        <Run Text="{Binding Author, Mode=OneWay}" />
                                        <Run Text="{Binding Downloads, Mode=OneWay, StringFormat={l:Loc Models_DownloadsFormat}}" />
                                        <Run Text="{Binding Likes, Mode=OneWay, StringFormat={l:Loc Models_LikesFormat}}" />
                                        <Run Text="{Binding PipelineTag, Mode=OneWay, StringFormat=' · {0}'}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Детали -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top" MinHeight="200">
                    <Grid>
                        <TextBlock Text="{l:Loc Models_SelectHint}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{DynamicResource SubtleButtonStyle}" Command="{Binding OpenOnHfCommand}" Content="{l:Loc Models_OpenHf}" />
                                <TextBlock Text="{Binding SelectedResult.Id}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,8">
                                <Run Text="{Binding SelectedResult.Architecture, Mode=OneWay}" />
                                <Run Text="{Binding SelectedResult.ContextLength, Mode=OneWay, StringFormat=' · ctx {0:N0}'}" />
                                <Run Text="{Binding SelectedResult.LastModified, Mode=OneWay, StringFormat=' · {0:d}'}" />
                            </TextBlock>
                            <StackPanel Margin="0,0,0,8" Visibility="{Binding IsLoadingDetails, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{l:Loc Models_LoadingDetails}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" TextWrapping="Wrap" />
                                <ProgressBar Style="{DynamicResource ProgressBarStyle}" IsIndeterminate="True" AutomationProperties.Name="{l:Loc Models_LoadingDetails}" />
                            </StackPanel>
                            <TextBlock Text="{Binding DetailsError}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusErrorBrush}"
                                       Visibility="{Binding DetailsError, Converter={StaticResource NullToCollapsed}}" />

                            <!-- Генератор изображений: файлы и их роли -->
                            <StackPanel Visibility="{Binding IsImageResult, Converter={StaticResource BoolToVisibility}}">
                                <c:AdaptiveRow ControlMinWidth="200">
                                    <TextBlock Text="{l:Loc ImgEngine_Family}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding ImageFamilies}" SelectedItem="{Binding ImageFamily}" ItemTemplate="{StaticResource EnumItemTemplate}" />
                                </c:AdaptiveRow>
                                <TextBlock Text="{l:Loc Models_ImagePickFiles}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding ImageFiles}" Margin="0,4,0,0" MaxHeight="260">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ImageFileOption}">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="130" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" ToolTip="{Binding File.Path}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Folder}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding Folder, Converter={StaticResource NullToCollapsed}}" />
                                                    </StackPanel>
                                                </CheckBox>
                                                <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource StatText}" VerticalAlignment="Center" Margin="8,0" />
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.ImageRoles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding Role}" ItemTemplate="{StaticResource EnumItemTemplate}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource StatText}" Margin="0,6,0,0">
                                    <Run Text="{l:Loc Models_ImageSelected}" /><Run Text="{Binding ImageSelectedSize, Mode=OneWay, StringFormat=' {0}'}" />
                                </TextBlock>
                                <TextBlock Text="{Binding ImageMissingText}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusWarnBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding ImageMissingText, Converter={StaticResource NullToCollapsed}}" />
                                <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding DownloadImageCommand}" HorizontalAlignment="Left" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconDownload}" Style="{StaticResource IconPath}" />
                                        <TextBlock Text="{l:Loc Models_DownloadImage}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Для задачи нет встроенного движка -->
                            <Border Style="{StaticResource NoticeCard}" Visibility="{Binding IsUnsupportedResult, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{l:Loc Models_NoRuntime}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            </Border>

                            <StackPanel Visibility="{Binding IsChatResult, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{l:Loc Models_ChooseQuant}" Style="{StaticResource CaptionText}" />
                            <ListBox ItemsSource="{Binding Quants}" SelectedItem="{Binding SelectedQuant}" MaxHeight="230" Margin="0,4,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:QuantItem}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Tier}" Style="{StaticResource CaptionText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0" Padding="6,0"
                                                            Visibility="{Binding Recommended, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{l:Loc Engine_Recommended}" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource AccentTextBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock x:Name="Est" Text="{Binding Estimate}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusOkBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Verdict}" Value="Tight">
                                                <Setter TargetName="Est" Property="Foreground" Value="{DynamicResource StatusWarnBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Verdict}" Value="DoesNotFit">
                                                <Setter TargetName="Est" Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <CheckBox Margin="0,10,0,0" IsChecked="{Binding IncludeMmproj}" Visibility="{Binding HasMmproj, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding MmprojInfo}" TextWrapping="Wrap" />
                            </CheckBox>

                            <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding DownloadCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    AutomationProperties.Name="{l:Loc Models_Download}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDownload}" Style="{StaticResource IconPath}" />
                                    <TextBlock Text="{l:Loc Models_Download}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            </StackPanel>

                            <!-- Ход загрузки этой модели: все шарды и mmproj одной полосой -->
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding SelectedDownload, Converter={StaticResource NullToCollapsed}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0"
                                                Visibility="{Binding IsSelectedDownloading, Converter={StaticResource BoolToVisibility}}">
                                        <Button Style="{StaticResource IconButton}" Command="{Binding PauseSelectedDownloadCommand}" ToolTip="{l:Loc Download_PauseResume}">
                                            <Path Data="M5,3 V13 M11,3 V13" Style="{StaticResource IconPath}" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Command="{Binding CancelSelectedDownloadCommand}" ToolTip="{l:Loc Common_Cancel}">
                                            <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedDownload.Text}" Style="{StaticResource StatText}" FontSize="{DynamicResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                                <ProgressBar Style="{DynamicResource ProgressBarStyle}" Value="{Binding SelectedDownload.Percent, Mode=OneWay}" Maximum="100" Margin="0,4,0,0"
                                             IsIndeterminate="{Binding SelectedDownload.Indeterminate, Mode=OneWay, FallbackValue=False}"
                                             Visibility="{Binding IsSelectedDownloading, Converter={StaticResource BoolToVisibility}}"
                                             AutomationProperties.Name="{Binding SelectedDownload.Text}" />
                                <TextBlock Text="{Binding SelectedDownload.Error}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusErrorBrush}"
                                           Visibility="{Binding SelectedDownload.Error, Converter={StaticResource NullToCollapsed}, FallbackValue=Collapsed}" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </c:ResponsiveGrid>

            <!-- README выбранной модели: во всю ширину под списком, Markdown как в чате -->
            <Expander Margin="0,12,0,0" Visibility="{Binding Readme, Converter={StaticResource NullToCollapsed}}">
                <Expander.Header>
                    <TextBlock Text="{l:Loc Models_Readme}" Style="{StaticResource SubtitleText}" />
                </Expander.Header>
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="16,12">
                    <r:MarkdownView Markdown="{Binding Readme}" />
                </Border>
            </Expander>

            <!-- ===== Параметры ===== -->
            <TextBlock Text="{l:Loc Models_Options}" Style="{StaticResource SubtitleText}" Margin="0,20,0,8" />
            <Border Style="{StaticResource SettingCard}">
                <c:AdaptiveRow>
                    <StackPanel>
                        <TextBlock Text="{l:Loc Models_DownloadFolder}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{Binding DownloadFolder}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Command="{Binding ChangeDownloadFolderCommand}" Content="{l:Loc Common_Browse}" HorizontalAlignment="Right" />
                </c:AdaptiveRow>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <c:AdaptiveRow ControlMinWidth="240">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Models_HfToken}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{l:Loc Models_HfTokenHint}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{l:Loc Models_HfTokenSaved}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusOkBrush}"
                                   Visibility="{Binding HasHfToken, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <PasswordBox x:Name="HfToken" LostFocus="OnHfTokenLostFocus" />
                </c:AdaptiveRow>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
