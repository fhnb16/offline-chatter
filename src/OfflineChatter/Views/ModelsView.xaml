<UserControl x:Class="OfflineChatter.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OfflineChatter.ViewModels"
             xmlns:views="clr-namespace:OfflineChatter.Views"
             xmlns:models="clr-namespace:OfflineChatter.Core.Models;assembly=OfflineChatter.Core"
             xmlns:l="clr-namespace:OfflineChatter.Localization"
             xmlns:r="clr-namespace:OfflineChatter.Rendering"
             xmlns:c="clr-namespace:OfflineChatter.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="EnumItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,32">
            <TextBlock Text="{l:Loc Nav_Models}" Style="{StaticResource PageTitleText}" />

            <!-- ===== Мои модели ===== -->
            <c:AdaptiveRow Margin="0,0,0,8" Breakpoint="640">
                <TextBlock Text="{l:Loc Models_Mine}" Style="{StaticResource SubtitleText}" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button Command="{Binding AddLocalCommand}" Margin="0,0,6,4">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Style="{StaticResource IconPath}" />
                            <TextBlock Text="{l:Loc Models_AddFile}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ScanCommand}" Margin="0,0,6,4">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSearch}" Style="{StaticResource IconPath}" />
                            <TextBlock Text="{l:Loc Models_Scan}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddScanFolderCommand}" Margin="0,0,0,4" ToolTip="{l:Loc Models_PickScanFolder}">
                        <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                    </Button>
                </WrapPanel>
            </c:AdaptiveRow>
            <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource CaptionText}" Margin="0,0,0,6"
                       Visibility="{Binding ScanStatus, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock Text="{l:Loc Models_NoneYet}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                       Visibility="{Binding HasLocalModels, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding LocalModels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LocalModelItem}">
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{l:Loc Models_Use}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.UseModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            IsEnabled="{Binding Exists}" />
                                    <Button Style="{DynamicResource SubtleButtonStyle}" ToolTip="{l:Loc Settings_OpenData}"
                                            Command="{Binding DataContext.OpenModelFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                                    </Button>
                                    <Button Style="{DynamicResource SubtleButtonStyle}" ToolTip="{l:Loc Common_Remove}"
                                            Command="{Binding DataContext.RemoveModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconTrash}" Style="{StaticResource IconPath}" />
                                    </Button>
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0" Padding="7,1"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{l:Loc Engine_Active}" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource StatusPill}" Margin="6,0,0,0" Padding="7,1"
                                                Visibility="{Binding HasVision, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconImage}" Style="{StaticResource IconPath}" Width="14" Height="14"
                                                      TextElement.Foreground="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.1" />
                                                <TextBlock Text="{l:Loc Models_Vision}" FontSize="11" Margin="4,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{l:Loc Models_Missing}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusErrorBrush}"
                                               Visibility="{Binding Exists, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Hugging Face ===== -->
            <TextBlock Text="{l:Loc Models_HfTitle}" Style="{StaticResource SubtitleText}" Margin="0,20,0,8" />
            <Border Style="{StaticResource SettingCard}">
                <c:AdaptiveRow>
                    <StackPanel>
                        <TextBlock Text="{l:Loc Models_DefaultTitle}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DefaultRepo}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <Button Command="{Binding ShowDefaultCommand}" Content="{l:Loc Models_ShowDefault}" HorizontalAlignment="Right" />
                </c:AdaptiveRow>
            </Border>

            <Grid Margin="0,4,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="Query" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,5,9,5">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Path Data="{StaticResource IconSearch}" Style="{StaticResource IconPath}" Margin="9,0,0,0" HorizontalAlignment="Left"
                          IsHitTestVisible="False" TextElement.Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Text="{l:Loc Models_SearchHint}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Visibility="{Binding Text, ElementName=Query, Converter={StaticResource EmptyToVisible}}" />
                </Grid>
                <ComboBox Grid.Column="1" MinWidth="150" Margin="8,0,0,0" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}"
                          ItemTemplate="{StaticResource EnumItemTemplate}" />
                <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding SearchCommand}" Content="{l:Loc Models_Search}" />
            </Grid>
            <WrapPanel Margin="0,0,0,8">
                <CheckBox Content="{l:Loc Models_VisionOnly}" IsChecked="{Binding VisionOnly}" Margin="0,0,20,4" />
                <CheckBox Content="{l:Loc Models_FitsOnly}" IsChecked="{Binding FitsOnly}" Margin="0,0,20,4" />
            </WrapPanel>
            <ProgressBar IsIndeterminate="True" Margin="0,0,0,8" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding SearchError}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusErrorBrush}"
                       Visibility="{Binding SearchError, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,8" />

            <!-- Список и детали: рядом на широком окне, друг под другом на узком.
                 Список прижат к верху: раньше он центрировался в растянутой ячейке, и при раскрытии README появлялись поля сверху и снизу. -->
            <c:ResponsiveGrid MinColumnWidth="340" MaxColumns="2">
                <!-- Результаты -->
                <Border Style="{StaticResource Card}" Padding="4" VerticalAlignment="Top">
                    <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" Height="460"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:HfModelSummary}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                        <Run Text="{Binding Author, Mode=OneWay}" />
                                        <Run Text="{Binding Downloads, Mode=OneWay, StringFormat={l:Loc Models_DownloadsFormat}}" />
                                        <Run Text="{Binding Likes, Mode=OneWay, StringFormat={l:Loc Models_LikesFormat}}" />
                                        <Run Text="{Binding PipelineTag, Mode=OneWay, StringFormat=' · {0}'}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Детали -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top" MinHeight="200">
                    <Grid>
                        <TextBlock Text="{l:Loc Models_SelectHint}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{DynamicResource SubtleButtonStyle}" Command="{Binding OpenOnHfCommand}" Content="{l:Loc Models_OpenHf}" />
                                <TextBlock Text="{Binding SelectedResult.Id}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,8">
                                <Run Text="{Binding SelectedResult.Architecture, Mode=OneWay}" />
                                <Run Text="{Binding SelectedResult.ContextLength, Mode=OneWay, StringFormat=' · ctx {0:N0}'}" />
                                <Run Text="{Binding SelectedResult.LastModified, Mode=OneWay, StringFormat=' · {0:d}'}" />
                            </TextBlock>
                            <ProgressBar IsIndeterminate="True" Margin="0,0,0,8" Visibility="{Binding IsLoadingDetails, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding DetailsError}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusErrorBrush}"
                                       Visibility="{Binding DetailsError, Converter={StaticResource NullToCollapsed}}" />

                            <TextBlock Text="{l:Loc Models_ChooseQuant}" Style="{StaticResource CaptionText}" />
                            <ListBox ItemsSource="{Binding Quants}" SelectedItem="{Binding SelectedQuant}" MaxHeight="230" Margin="0,4,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:QuantItem}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Tier}" Style="{StaticResource CaptionText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0" Padding="6,0"
                                                            Visibility="{Binding Recommended, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{l:Loc Engine_Recommended}" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock x:Name="Est" Text="{Binding Estimate}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusOkBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Verdict}" Value="Tight">
                                                <Setter TargetName="Est" Property="Foreground" Value="{DynamicResource StatusWarnBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Verdict}" Value="DoesNotFit">
                                                <Setter TargetName="Est" Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <CheckBox Margin="0,10,0,0" IsChecked="{Binding IncludeMmproj}" Visibility="{Binding HasMmproj, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding MmprojInfo}" TextWrapping="Wrap" />
                            </CheckBox>

                            <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding DownloadCommand}" HorizontalAlignment="Left" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDownload}" Style="{StaticResource IconPath}" />
                                    <TextBlock Text="{l:Loc Models_Download}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </c:ResponsiveGrid>

            <!-- README выбранной модели: во всю ширину под списком, Markdown как в чате -->
            <Expander Margin="0,12,0,0" Visibility="{Binding Readme, Converter={StaticResource NullToCollapsed}}">
                <Expander.Header>
                    <TextBlock Text="{l:Loc Models_Readme}" Style="{StaticResource SubtitleText}" />
                </Expander.Header>
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="16,12">
                    <r:MarkdownView Markdown="{Binding Readme}" />
                </Border>
            </Expander>

            <!-- ===== Параметры ===== -->
            <TextBlock Text="{l:Loc Models_Options}" Style="{StaticResource SubtitleText}" Margin="0,20,0,8" />
            <Border Style="{StaticResource SettingCard}">
                <c:AdaptiveRow>
                    <StackPanel>
                        <TextBlock Text="{l:Loc Models_DownloadFolder}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{Binding DownloadFolder}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Command="{Binding ChangeDownloadFolderCommand}" Content="{l:Loc Common_Browse}" HorizontalAlignment="Right" />
                </c:AdaptiveRow>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <c:AdaptiveRow ControlMinWidth="240">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Models_HfToken}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{l:Loc Models_HfTokenHint}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{l:Loc Models_HfTokenSaved}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource StatusOkBrush}"
                                   Visibility="{Binding HasHfToken, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <PasswordBox x:Name="HfToken" LostFocus="OnHfTokenLostFocus" />
                </c:AdaptiveRow>
            </Border>

            <views:DownloadsView DataContext="{Binding Downloads}" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
