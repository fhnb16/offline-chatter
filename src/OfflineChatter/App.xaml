<Application x:Class="OfflineChatter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Скины (системный словарь или Fluent) вставляет ThemeManager перед этими словарями -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Skins/Shared.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
