<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:OfflineChatter.Converters">
    <!--
        Ресурсы, общие для всех скинов. Цвета — только через DynamicResource на токены ThemeKeys.
        Иконки — векторные контуры 16×16: на Win7 нет шрифтов Segoe MDL2 / Fluent Icons.
    -->

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:EnumDisplayConverter x:Key="EnumDisplay" />
    <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisible" />
    <conv:ResourceKeyConverter x:Key="ResourceKeyToGeometry" />
    <conv:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
    <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <conv:BytesConverter x:Key="Bytes" />
    <conv:TaskbarStateConverter x:Key="TaskbarState" />

