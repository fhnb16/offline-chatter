<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:OfflineChatter.Converters">
    <!--
        Ресурсы, общие для всех скинов. Цвета — только через DynamicResource на токены ThemeKeys.
        Иконки — векторные контуры 16×16: на Win7 нет шрифтов Segoe MDL2 / Fluent Icons.
    -->

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:EnumDisplayConverter x:Key="EnumDisplay" />
    <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisible" />
    <conv:ResourceKeyConverter x:Key="ResourceKeyToGeometry" />
    <conv:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
    <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <conv:BytesConverter x:Key="Bytes" />
    <conv:TaskbarStateConverter x:Key="TaskbarState" />

    <!-- ===== Иконки ===== -->
    <Geometry x:Key="IconPlus">M8,2.5 V13.5 M2.5,8 H13.5</Geometry>
    <Geometry x:Key="IconSend">M2.5,2.5 L14,8 L2.5,13.5 L4.5,8 Z M4.5,8 H9</Geometry>
    <Geometry x:Key="IconAttach">M11,4.5 L5.6,9.9 A1.6,1.6 0 0 0 7.9,12.2 L13,7.1 A3,3 0 0 0 8.8,2.9 L3.6,8.1 A4.4,4.4 0 0 0 9.8,14.3 L14,10.1</Geometry>
    <!-- Шестерёнка: 6 зубцов — при 16 px и толщине линии 1.3 зазоры между ними не слипаются -->
    <Geometry x:Key="IconSettings">M6.6,3.41 L6.85,1.5 A6.6,6.6 0 0 1 9.15,1.5 L9.4,3.41 A4.8,4.8 0 0 1 11.27,4.49 L13.06,3.76 A6.6,6.6 0 0 1 14.2,5.74 L12.68,6.92 A4.8,4.8 0 0 1 12.68,9.08 L14.2,10.26 A6.6,6.6 0 0 1 13.06,12.24 L11.27,11.51 A4.8,4.8 0 0 1 9.4,12.59 L9.15,14.5 A6.6,6.6 0 0 1 6.85,14.5 L6.6,12.59 A4.8,4.8 0 0 1 4.73,11.51 L2.94,12.24 A6.6,6.6 0 0 1 1.8,10.26 L3.32,9.08 A4.8,4.8 0 0 1 3.32,6.92 L1.8,5.74 A6.6,6.6 0 0 1 2.94,3.76 L4.73,4.49 A4.8,4.8 0 0 1 6.6,3.41 Z M8,5.9 A2.1,2.1 0 1 1 7.99,5.9</Geometry>
    <Geometry x:Key="IconSearch">M6.8,2.5 A4.3,4.3 0 1 1 6.79,2.5 M9.9,9.9 L13.5,13.5</Geometry>
    <Geometry x:Key="IconChat">M2.5,3.5 H13.5 V11 H6.5 L3.5,13.5 V11 H2.5 Z</Geometry>
    <Geometry x:Key="IconPanel">M2.5,3 H13.5 V13 H2.5 Z M10,3 V13</Geometry>
    <Geometry x:Key="IconStop">M4.5,4.5 H11.5 V11.5 H4.5 Z</Geometry>
    <Geometry x:Key="IconChip">M4.5,4.5 H11.5 V11.5 H4.5 Z M6.5,1.5 V4.5 M9.5,1.5 V4.5 M6.5,11.5 V14.5 M9.5,11.5 V14.5 M1.5,6.5 H4.5 M1.5,9.5 H4.5 M11.5,6.5 H14.5 M11.5,9.5 H14.5</Geometry>
    <Geometry x:Key="IconDownload">M8,2 V10.5 M4.5,7 L8,10.5 L11.5,7 M2.5,13.5 H13.5</Geometry>
    <Geometry x:Key="IconCube">M8,1.5 L14,4.8 V11.2 L8,14.5 L2,11.2 V4.8 Z M2,4.8 L8,8 L14,4.8 M8,8 V14.5</Geometry>
    <Geometry x:Key="IconCloud">M4.5,12.5 A3,3 0 0 1 4.2,6.6 A4,4 0 0 1 11.8,6.2 A3.2,3.2 0 0 1 11.8,12.5 Z</Geometry>
    <Geometry x:Key="IconPlug">M5.5,1.5 V4.5 M10.5,1.5 V4.5 M3.5,4.5 H12.5 V7.5 A4.5,4.5 0 0 1 3.5,7.5 Z M8,12 V14.5</Geometry>
    <Geometry x:Key="IconGauge">M2,11.5 A6,6 0 1 1 14,11.5 M8,11 L11,6</Geometry>
    <Geometry x:Key="IconList">M5.5,4 H14 M5.5,8 H14 M5.5,12 H14 M2,4 H2.5 M2,8 H2.5 M2,12 H2.5</Geometry>
    <Geometry x:Key="IconFolder">M1.5,4 V12.5 H14.5 V5.5 H7.5 L6,3.5 H2 Z</Geometry>
    <Geometry x:Key="IconRefresh">M13,8 A5,5 0 1 1 11.5,4.4 M11.5,1.5 V4.5 H8.5</Geometry>
    <Geometry x:Key="IconPlay">M4.5,2.5 L13,8 L4.5,13.5 Z</Geometry>
    <Geometry x:Key="IconTrash">M2.5,4 H13.5 M6,4 V2.5 H10 V4 M4,4 L4.8,14 H11.2 L12,4 M6.5,6.5 V11.5 M9.5,6.5 V11.5</Geometry>
    <Geometry x:Key="IconCopy">M5.5,5.5 H13.5 V13.5 H5.5 Z M3,10.5 H2.5 V2.5 H10.5 V3</Geometry>
    <Geometry x:Key="IconExport">M8,10 V1.5 M4.5,5 L8,1.5 L11.5,5 M2.5,9 V14 H13.5 V9</Geometry>
    <Geometry x:Key="IconEdit">M10.5,2.5 L13.5,5.5 L5.5,13.5 H2.5 V10.5 Z</Geometry>
    <Geometry x:Key="IconCheck">M3,8.5 L6.5,12 L13,4.5</Geometry>
    <Geometry x:Key="IconClose">M3.5,3.5 L12.5,12.5 M12.5,3.5 L3.5,12.5</Geometry>
    <Geometry x:Key="IconImage">M2,3 H14 V13 H2 Z M2,11 L6,7 L9.5,10.5 L11,9 L14,12 M10.5,5.8 A0.8,0.8 0 1 1 10.49,5.8</Geometry>
    <Geometry x:Key="IconBranch">M5,2.5 V13.5 M5,9 C5,6 11,7 11,4.5 M11,2.5 V4.5</Geometry>
    <Geometry x:Key="IconPin">M6,2 H10 M7,2 V6.5 L4.5,9 H11.5 L9,6.5 V2 M8,9 V14</Geometry>
    <Geometry x:Key="IconEye">M1.5,8 C3.5,4 12.5,4 14.5,8 C12.5,12 3.5,12 1.5,8 Z M8,6.2 A1.8,1.8 0 1 1 7.99,6.2</Geometry>
    <Geometry x:Key="IconTool">M10.5,2 A3,3 0 0 0 9.2,6.5 L2.5,13.2 L3.8,14.5 L10.5,7.8 A3,3 0 0 0 14,5.5 L12,6 L10.5,4.5 L11,2.5 Z</Geometry>
    <Geometry x:Key="IconRetry">M3,8 A5,5 0 1 0 4.5,4.4 M4.5,1.5 V4.5 H7.5</Geometry>
    <Geometry x:Key="IconSpeak">M2.5,6 H5 L8.5,3 V13 L5,10 H2.5 Z M11,5.5 A3.5,3.5 0 0 1 11,10.5</Geometry>
    <Geometry x:Key="IconImport">M8,1.5 V10 M4.5,6.5 L8,10 L11.5,6.5 M2.5,9 V14 H13.5 V9</Geometry>
    <Geometry x:Key="IconKey">M5,5.5 A2.5,2.5 0 1 1 4.99,5.5 M7.5,8 H14 M12,8 V10.5 M14,8 V10</Geometry>
    <Geometry x:Key="IconOffline">M2,2 L14,14 M5,9.5 A4.5,4.5 0 0 1 8,8.5 M2.5,6.5 A8,8 0 0 1 6,4.6 M10.5,4.8 A8,8 0 0 1 13.5,6.5 M8,12 V12.5</Geometry>
    <Geometry x:Key="IconChevronLeft">M10,3 L5,8 L10,13</Geometry>
    <Geometry x:Key="IconChevronRight">M6,3 L11,8 L6,13</Geometry>

    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
        <Setter Property="StrokeThickness" Value="1.3" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Типографика ===== -->
    <!--
        Размер, насыщенность и цвет заголовков — токены скина: во Fluent крупные полужирные,
        в Aero — «main instruction» Windows 7 (12 pt, обычное начертание, синий).
    -->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource TitleFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource HeadingFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}" />
    </Style>
    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource SubtitleFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource HeadingFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="SectionHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource HeadingFontWeight}" />
        <Setter Property="Margin" Value="0,14,0,6" />
        <Setter Property="Foreground" Value="{DynamicResource SectionHeaderBrush}" />
    </Style>

    <!-- ===== Карточки ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource PillCornerRadius}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Точка состояния llama-server (DataContext — ServerInsightViewModel): готов, загружается, ошибка, остановлен -->
    <Style x:Key="ServerStateDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Ready">
                <Setter Property="Fill" Value="{DynamicResource StatusOkBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Starting">
                <Setter Property="Fill" Value="{DynamicResource StatusWarnBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Loading">
                <Setter Property="Fill" Value="{DynamicResource StatusWarnBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Failed">
                <Setter Property="Fill" Value="{DynamicResource StatusErrorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Точка состояния подключения (DataContext — EndpointStatusViewModel): локальный сервер или API-провайдер -->
    <Style x:Key="EndpointStateDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DotState}" Value="Ready">
                <Setter Property="Fill" Value="{DynamicResource StatusOkBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DotState}" Value="Starting">
                <Setter Property="Fill" Value="{DynamicResource StatusWarnBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DotState}" Value="Failed">
                <Setter Property="Fill" Value="{DynamicResource StatusErrorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Полоса команд над содержимым страницы. Во Fluent невидима (прозрачный фон, рамки нет),
        в Aero — панель команд Проводника Windows 7, в Aero2 — плоская серая полоса Windows 8.
    -->
    <Style x:Key="CommandBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ToolbarBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToolbarBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ToolbarBorderThickness}" />
    </Style>

    <!-- Текст на стекле Win7 получает свечение; на остальных подложках эффект = null -->
    <Style x:Key="GlassText" TargetType="TextBlock">
        <Setter Property="Effect" Value="{DynamicResource GlassTextEffect}" />
    </Style>

    <!-- Страница: заголовок + прокручиваемое содержимое -->
    <Style x:Key="PageTitleText" TargetType="TextBlock" BasedOn="{StaticResource TitleText}">
        <Setter Property="FontSize" Value="{DynamicResource PageTitleFontSize}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!--
        Поле поиска: значок, подсказка (Tag) и текст стоят на одной линии в любом скине.
        Свой шаблон, потому что у системных скинов и у Fluent разные внутренние отступы,
        и наложенные поверх значок с подсказкой разъезжались с текстом.
    -->

    <!-- Полоса вкладок: собственный шаблон, одинаковый во всех скинах; переносится на узком окне -->


    <!-- Цифры статистики: моноширинные, чтобы значения не «прыгали» при обновлении -->
    <Style x:Key="StatText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>

    <!--
        Небольшая кнопка-иконка без рамки (действия под сообщением, удаление строк). Форма и подсветка — токены скина:
        во Fluent — скруглённая заливка, в Aero — как кнопка панели инструментов Проводника (градиент с рамкой).
    -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Cursor" Value="{DynamicResource ActionCursor}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource ControlCornerRadius}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SubtleHoverBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Блок правой панели чата: флажок «показывать» (всплывающее окно панели) -->
    <DataTemplate x:Key="InspectorToggleTemplate">
        <CheckBox IsChecked="{Binding IsVisible}" Margin="0,4" ToolTip="{Binding Hint}">
            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" />
        </CheckBox>
    </DataTemplate>
    <!-- То же с пояснением под названием (настройки и мастер первого запуска) -->
    <DataTemplate x:Key="InspectorToggleDetailedTemplate">
        <CheckBox IsChecked="{Binding IsVisible}" Margin="0,4">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" />
                <TextBlock Text="{Binding Hint}" Style="{StaticResource CaptionText}" />
            </StackPanel>
        </CheckBox>
    </DataTemplate>

    <!-- Плашка-предупреждение внутри страницы (офлайн-режим, нужен перезапуск и т. п.) -->
    <Style x:Key="NoticeCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SelectedItemBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Плитка выбора акцентного цвета -->
    <Style x:Key="SwatchButton" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                            BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
