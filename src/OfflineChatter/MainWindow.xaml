<Window x:Class="OfflineChatter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OfflineChatter.ViewModels"
        xmlns:views="clr-namespace:OfflineChatter.Views"
        xmlns:theme="clr-namespace:OfflineChatter.Theming"
        xmlns:l="clr-namespace:OfflineChatter.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Offline Chatter"
        Width="1180" Height="760" MinWidth="760" MinHeight="480"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="13"
        UseLayoutRounding="True"
        theme:ShellChrome.ExtendIntoTitleBar="True">

    <Window.Resources>
        <!-- Страница → представление -->
        <DataTemplate DataType="{x:Type vm:ChatPageViewModel}">
            <views:ChatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModelsViewModel}">
            <views:ModelsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompareViewModel}">
            <views:CompareView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WelcomeViewModel}">
            <views:WelcomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:McpViewModel}">
            <views:McpView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BenchmarksViewModel}">
            <views:BenchmarksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProvidersViewModel}">
            <views:ProvidersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EngineViewModel}">
            <views:EngineView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
        <!-- Подпись в боковой панели: скрыта, когда панель свёрнута до иконок -->
        <Style x:Key="SidebarLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Элемент свёрнутой панели: подсказка с подписью (текст — в Tag) -->
        <Style x:Key="RailTip" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="ToolTipService.Placement" Value="Right" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Видно только в развёрнутой / только в свёрнутой панели -->
        <Style x:Key="ExpandedOnly" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Прогресс загрузок на кнопке в панели задач (Win7+) -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding Downloads.AggregateProgress, Converter={StaticResource TaskbarState}}"
                         ProgressValue="{Binding Downloads.AggregateProgress, TargetNullValue=0, FallbackValue=0}" />
    </Window.TaskbarItemInfo>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewChatCommand}" />
        <KeyBinding Key="M" Modifiers="Control+Shift" Command="{Binding ToggleCompactCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleSidebarCommand}" />
    </Window.InputBindings>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="200" MaxWidth="480" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- Полоса заголовка: есть только когда заголовок совмещён с содержимым -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= Полоса заголовка ================= -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent"
                Height="{Binding (theme:ShellChrome.TitleBarHeight), RelativeSource={RelativeSource AncestorType=Window}}"
                Visibility="{Binding (theme:ShellChrome.IsExtended), RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Width, ElementName=SidebarColumn}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/OfflineChatter;component/Assets/app.ico" Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Offline Chatter" Margin="8,0,0,0" FontSize="12" Style="{StaticResource GlassText}"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding CurrentPage.Title}" FontSize="12" Margin="16,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource GlassText}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           MaxWidth="600" HorizontalAlignment="Left" />
            </Grid>
        </Border>

        <!-- ================= Боковая панель ================= -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
                Visibility="{Binding IsCompact, Converter={StaticResource InverseBoolToVisibility}}">
            <DockPanel Margin="10,8,8,10">
                <StackPanel DockPanel.Dock="Top">
                    <!-- Свёрнутая панель: «развернуть» над «новым чатом» -->
                    <Button Style="{DynamicResource SubtleButtonStyle}" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,6"
                            Command="{Binding ToggleSidebarCommand}" ToolTip="{l:Loc Sidebar_Expand}" ToolTipService.Placement="Right"
                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}}">
                        <Path Data="{StaticResource IconChevronRight}" Style="{StaticResource IconPath}" />
                    </Button>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{DynamicResource SubtleButtonStyle}" Margin="6,0,0,0" Padding="8,6"
                                Command="{Binding ToggleSidebarCommand}" ToolTip="{l:Loc Sidebar_Collapse}"
                                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                            <Path Data="{StaticResource IconChevronLeft}" Style="{StaticResource IconPath}" />
                        </Button>
                        <Button Command="{Binding NewChatCommand}" HorizontalContentAlignment="Left" Padding="10,6" ToolTip="Ctrl+N">
                            <StackPanel Orientation="Horizontal" Style="{StaticResource RailTip}" Tag="{l:Loc Chat_New}">
                                <Path Data="{StaticResource IconPlus}" Style="{StaticResource IconPath}" />
                                <TextBlock Text="{l:Loc Chat_New}" Style="{StaticResource SidebarLabel}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <Button Style="{DynamicResource SubtleButtonStyle}" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,6,0,0"
                            Click="OnRailSearch" ToolTip="{l:Loc Chat_Search}" ToolTipService.Placement="Right"
                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}}">
                        <Path Data="{StaticResource IconSearch}" Style="{StaticResource IconPath}" />
                    </Button>

                    <Grid Margin="0,10,0,6" Style="{StaticResource ExpandedOnly}">
                        <TextBox x:Name="SearchBox" Style="{DynamicResource SearchBox}" Tag="{l:Loc Chat_Search}"
                                 Text="{Binding Chat.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>

                <!-- Навигация по разделам -->
                <ListBox DockPanel.Dock="Bottom" Margin="0,8,0,0" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <StackPanel Orientation="Horizontal" Style="{StaticResource RailTip}" Tag="{Binding Title}">
                                <Path Style="{StaticResource IconPath}" Data="{Binding IconKey, Converter={StaticResource ResourceKeyToGeometry}}" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SidebarLabel}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource DividerBrush}" Margin="4,8,4,0" />

                <!-- Состояние: офлайн-режим и доступное обновление (тихие строки, без цветных плашек) -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <!-- Активная модель и сборка llama.cpp с точкой состояния сервера; щелчок — раздел «Движок» -->
                    <Button Style="{DynamicResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Command="{Binding OpenEngineCommand}" ToolTip="{Binding Server.Summary}" ToolTipService.Placement="Right">
                        <Grid DataContext="{Binding Server}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Style="{StaticResource ServerStateDot}" HorizontalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource ExpandedOnly}">
                                <TextBlock Text="{Binding ModelTitle}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding StatusLine}" Style="{StaticResource StatText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Style="{DynamicResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Command="{Binding OpenDownloadsCommand}" Visibility="{Binding Downloads.IsActive, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Style="{StaticResource RailTip}" Tag="{Binding Downloads.ActiveSummary}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Style="{StaticResource IconPath}" TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Downloads.ActiveSummary}" Style="{StaticResource SidebarLabel}" FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ProgressBar Value="{Binding Downloads.AggregatePercent, Mode=OneWay}" Maximum="100" Height="3" Margin="0,6,0,0"
                                         IsIndeterminate="{Binding Downloads.IsAggregateIndeterminate, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{Binding OpenPrivacyCommand}" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{l:Loc Net_OfflineHint}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconOffline}" Style="{StaticResource IconPath}" TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{l:Loc Net_OfflineBadge}" Style="{StaticResource SidebarLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{Binding OpenUpdatesCommand}" Visibility="{Binding UpdateBadge, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel Orientation="Horizontal" Style="{StaticResource RailTip}" Tag="{Binding UpdateBadge}">
                            <Path Data="{StaticResource IconDownload}" Style="{StaticResource IconPath}" TextElement.Foreground="{DynamicResource AccentTextBrush}" />
                            <TextBlock Text="{Binding UpdateBadge}" Style="{StaticResource SidebarLabel}" Foreground="{DynamicResource AccentTextBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{Binding OpenEngineUpdateCommand}" Visibility="{Binding EngineUpdateBadge, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel Orientation="Horizontal" Style="{StaticResource RailTip}" Tag="{Binding EngineUpdateBadge}">
                            <Path Data="{StaticResource IconChip}" Style="{StaticResource IconPath}" TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding EngineUpdateBadge}" Style="{StaticResource SidebarLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- IsSynchronizedWithCurrentItem=False: иначе «текущий элемент» общего представления при уходе со страницы чата
                     уезжал на первый чат, и при возврате открывался не тот чат, где шла генерация -->
                <ListBox ItemsSource="{Binding Chat.FilteredChats}" SelectedItem="{Binding Chat.SelectedChat}" IsSynchronizedWithCurrentItem="False" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChatListItem}">
                            <DockPanel Background="Transparent">
                                <DockPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:Loc Chat_Pin}" Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                        <MenuItem Header="{l:Loc Common_Remove}" Command="{Binding PlacementTarget.Tag.DeleteChatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </DockPanel.ContextMenu>
                                <DockPanel.Tag>
                                    <Binding Path="DataContext.Chat" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </DockPanel.Tag>
                                <Path DockPanel.Dock="Right" Data="{StaticResource IconPin}" Style="{StaticResource IconPath}" Width="14" Height="14"
                                      TextElement.Foreground="{DynamicResource TextTertiaryBrush}"
                                      Visibility="{Binding Pinned, Converter={StaticResource BoolToVisibility}}" />
                                <Path Data="{StaticResource IconChat}" Style="{StaticResource IconPath}" TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Title}" Margin="10,0,4,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter x:Name="SidebarSplitter" Grid.Row="1" Grid.Column="0" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                      ResizeBehavior="CurrentAndNext" Background="Transparent" Focusable="False"
                      DragCompleted="OnSidebarResized" />

        <!-- ================= Текущая страница ================= -->
        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource ContentBackgroundBrush}"
                BorderBrush="{DynamicResource ContentBorderBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Top" Height="2" MinHeight="0" Maximum="100" BorderThickness="0" Margin="8,0,8,0"
                             Value="{Binding Downloads.AggregatePercent, Mode=OneWay}"
                             IsIndeterminate="{Binding Downloads.IsAggregateIndeterminate, Mode=OneWay}"
                             Visibility="{Binding Downloads.IsActive, Converter={StaticResource BoolToVisibility}}"
                             ToolTip="{Binding Downloads.ActiveSummary}" />
                <!-- Компактный режим: с любой страницы обратно к чату -->
                <DockPanel DockPanel.Dock="Top" Margin="16,10,16,0" Visibility="{Binding ShowBackToChat, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Left" Style="{DynamicResource SubtleButtonStyle}" Command="{Binding BackToChatCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconChevronLeft}" Style="{StaticResource IconPath}" />
                            <TextBlock Text="{l:Loc Compact_BackToChat}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{DynamicResource SubtleButtonStyle}" Command="{Binding ToggleCompactCommand}"
                            Content="{l:Loc Compact_Exit}" ToolTip="Ctrl+Shift+M" />
                </DockPanel>
                <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
