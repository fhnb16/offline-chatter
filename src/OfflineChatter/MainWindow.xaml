<Window x:Class="OfflineChatter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OfflineChatter.ViewModels"
        Title="Offline Chatter"
        Width="1180" Height="760" MinWidth="720" MinHeight="460"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="13"
        UseLayoutRounding="True">
    <!-- TODO(l10n): строки интерфейса перенести в Strings.resx -->

    <Window.Resources>
        <DataTemplate x:Key="EnumItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MessageViewModel}">
            <Border x:Name="Bubble" Margin="0,0,0,12" MaxWidth="760" HorizontalAlignment="Left"
                    Style="{StaticResource Card}">
                <TextBox x:Name="Body" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14">
                    <!-- Read-only TextBox: выделение и копирование. Markdown-рендер — этап 6. -->
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Bubble" Property="MaxWidth" Value="600" />
                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource UserBubbleBrush}" />
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource UserBubbleBrush}" />
                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource UserBubbleTextBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewChatCommand}" />
    </Window.InputBindings>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="180" MaxWidth="480" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Боковая панель ================= -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
            <DockPanel Margin="10,12,8,10">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Offline Chatter" Style="{StaticResource SubtitleText}" Margin="6,0,0,12" />

                    <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding NewChatCommand}"
                            HorizontalContentAlignment="Left" Padding="10,6" ToolTip="Ctrl+N">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Style="{StaticResource IconPath}" />
                            <TextBlock Text="Новый чат" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Grid Margin="0,10,0,6">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,5,9,5" />
                        <Path Data="{StaticResource IconSearch}" Style="{StaticResource IconPath}" Margin="9,0,0,0"
                              HorizontalAlignment="Left" IsHitTestVisible="False"
                              TextElement.Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="Поиск по чатам" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}" />
                    </Grid>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Style="{DynamicResource SubtleButtonStyle}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                            IsEnabled="False" ToolTip="Этап 4">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDownload}" Style="{StaticResource IconPath}" />
                            <TextBlock Text="Модели и движок" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource SubtleButtonStyle}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                            Command="{Binding ToggleInspectorCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSettings}" Style="{StaticResource IconPath}" />
                            <TextBlock Text="Оформление и сведения" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ListBox ItemsSource="{Binding Chats}" SelectedItem="{Binding SelectedChat}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconChat}" Style="{StaticResource IconPath}"
                                      TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="0" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                      ResizeBehavior="CurrentAndNext" Background="Transparent" Focusable="False"
                      DragCompleted="OnSidebarResized" />

        <!-- ================= Контент ================= -->
        <Border Grid.Column="1" Background="{DynamicResource ContentBackgroundBrush}"
                BorderBrush="{DynamicResource ContentBorderBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовок: модель и статус движка -->
                <DockPanel Grid.Row="0" Grid.Column="0" Margin="20,12,12,8" LastChildFill="False">
                    <ComboBox DockPanel.Dock="Left" MinWidth="240" IsEnabled="False" SelectedIndex="0">
                        <ComboBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconChip}" Style="{StaticResource IconPath}" />
                                <TextBlock Text="{Binding ModelName}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>
                    <Border DockPanel.Dock="Left" Style="{StaticResource StatusPill}" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusWarnBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding EngineStatus}" Margin="7,0,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Button DockPanel.Dock="Right" Style="{DynamicResource SubtleButtonStyle}" Command="{Binding ToggleInspectorCommand}"
                            ToolTip="Показать или скрыть панель справа">
                        <Path Data="{StaticResource IconPanel}" Style="{StaticResource IconPath}" />
                    </Button>
                </DockPanel>

                <!-- Сообщения -->
                <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="20,4,20,8">
                    <ItemsControl ItemsSource="{Binding SelectedChat.Messages}" />
                </ScrollViewer>

                <!-- Пустое состояние -->
                <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640"
                            Visibility="{Binding HasMessages, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="Чем могу помочь?" Style="{StaticResource TitleText}" HorizontalAlignment="Center" FontSize="24" />
                    <TextBlock Text="Локальные GGUF-модели через llama.cpp или любой OpenAI-совместимый API."
                               Style="{StaticResource CaptionText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,18" />
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Margin="4" Command="{Binding UseSuggestionCommand}" CommandParameter="Объясни формулу Эйлера e^{iπ} + 1 = 0"
                                Content="Объясни формулу Эйлера" />
                        <Button Margin="4" Command="{Binding UseSuggestionCommand}" CommandParameter="Напиши функцию быстрой сортировки на C#"
                                Content="Быстрая сортировка на C#" />
                        <Button Margin="4" Command="{Binding UseSuggestionCommand}" CommandParameter="Опиши, что изображено на картинке"
                                Content="Описать картинку" />
                    </WrapPanel>
                </StackPanel>

                <!-- Поле ввода -->
                <Border Grid.Row="2" Grid.Column="0" Margin="20,4,20,6" Style="{StaticResource Card}" Padding="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{DynamicResource SubtleButtonStyle}" VerticalAlignment="Bottom"
                                IsEnabled="False" ToolTip="Прикрепить файл или изображение (этап 6)">
                            <Path Data="{StaticResource IconAttach}" Style="{StaticResource IconPath}" />
                        </Button>
                        <Grid Grid.Column="1" Margin="4,0">
                            <TextBox x:Name="InputBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="200" MinHeight="34"
                                     VerticalScrollBarVisibility="Auto" FontSize="14"
                                     Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="Сообщение… (Enter — отправить, Shift+Enter — новая строка)" Margin="10,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" FontSize="14"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Visibility="{Binding Text, ElementName=InputBox, Converter={StaticResource EmptyToVisible}}" />
                        </Grid>
                        <Button Grid.Column="2" Style="{DynamicResource AccentButtonStyle}" VerticalAlignment="Bottom"
                                Command="{Binding SendCommand}" ToolTip="Отправить (Enter)" Padding="10,6">
                            <Path Data="{StaticResource IconSend}" Style="{StaticResource IconPath}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Строка состояния -->
                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="24,0,20,10">
                    <TextBlock Style="{StaticResource CaptionText}" Text="Генерация: — ток/с" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="  ·  Промпт: — ток/с" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="  ·  До первого токена: —" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="  ·  Контекст: — / —" />
                </StackPanel>

                <!-- ================= Правая панель ================= -->
                <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Width="300"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0"
                        Visibility="{Binding IsInspectorVisible, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12,16,16">
                        <StackPanel DataContext="{Binding Appearance}">
                            <TextBlock Text="Оформление" Style="{StaticResource SubtitleText}" />

                            <TextBlock Text="Стиль элементов" Style="{StaticResource SectionHeaderText}" />
                            <ComboBox ItemsSource="{Binding SkinOptions}" SelectedItem="{Binding Skin}"
                                      ItemTemplate="{StaticResource EnumItemTemplate}" />

                            <TextBlock Text="Тема" Style="{StaticResource SectionHeaderText}" />
                            <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding Mode}"
                                      ItemTemplate="{StaticResource EnumItemTemplate}" />

                            <TextBlock Text="Подложка окна" Style="{StaticResource SectionHeaderText}" />
                            <ComboBox ItemsSource="{Binding BackdropOptions}" SelectedItem="{Binding Backdrop}"
                                      ItemTemplate="{StaticResource EnumItemTemplate}" />

                            <TextBlock Text="Акцентный цвет" Style="{StaticResource SectionHeaderText}" />
                            <ComboBox ItemsSource="{Binding AccentOptions}" SelectedItem="{Binding Accent}"
                                      ItemTemplate="{StaticResource EnumItemTemplate}" />
                            <ItemsControl ItemsSource="{Binding Swatches}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SwatchButton}" Background="{Binding}" ToolTip="{Binding}"
                                                Command="{Binding DataContext.PickSwatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox Text="{Binding CustomAccent, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"
                                     Visibility="{Binding IsCustomAccent, Converter={StaticResource BoolToVisibility}}"
                                     ToolTip="#RRGGBB" />

                            <TextBlock Text="{Binding ResolvedSummary}" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />

                            <TextBlock Text="Система" Style="{StaticResource SubtitleText}" Margin="0,24,0,0" />
                            <TextBlock Text="{Binding DataContext.OsName, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding DataContext.RuntimeInfo, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding DataContext.DataLocation, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
