<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <!-- Если 4.8 не установлен, Windows покажет штатный диалог со ссылкой на загрузку -->
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!--
      DoNotScaleForDpiChanges=false      — включает Per-Monitor DPI в WPF 4.7.2+
      DontEnableSchUseStrongCrypto=false — сильная криптография SChannel (TLS 1.2 на Win7)
      DontEnableSystemDefaultTlsVersions=false — версии TLS по умолчанию берутся из ОС
    -->
    <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false;Switch.System.Net.DontEnableSchUseStrongCrypto=false;Switch.System.Net.DontEnableSystemDefaultTlsVersions=false" />
  </runtime>
</configuration>
